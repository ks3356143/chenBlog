---
import { getCategoryList } from "@/utils/content-utils"
import { Icon } from "astro-icon/components"

const categories = await getCategoryList()

// 声明折叠高度
const collapsedHeight = "7.5rem"
let isCollapsed = true
---

<div class="card-base pb-4" data-category-card>
	<div class="card-title">分类</div>
	<div data-category-list data-is-collapsed="true" class="collapsed overflow-hidden px-4">
		{
			categories.map(category => (
				<a href={category.url} aria-label={`posts in ${category.name}`}>
					<button class="btn-right">
						<div class="relative mr-2 flex items-center justify-between">
							<div class="overflow-hidden text-left text-ellipsis whitespace-nowrap">{category.name}</div>
							<div class="counter-tag">{category.count}</div>
						</div>
					</button>
				</a>
			))
		}
	</div>
	{
		isCollapsed && (
			<div data-category-expand class="-mb-2 px-4">
				<button class="btn-plain h-9 w-full text-(--primary)" title="更多" aria-label="更多">
					<div class="flex items-center justify-center gap-2">
						<Icon name="more" />
						<span>更多</span>
					</div>
				</button>
			</div>
		)
	}
</div>

<style define:vars={{ collapsedHeight }}>
	.collapsed {
		height: var(--collapsedHeight);
	}
</style>

<script>
	// 点击「更多」展开分类列表。
	// ⚠️ 本卡在页面上渲染两份（md+ 左栏 + 移动端底部堆，见 Layout.astro），必须逐实例绑定：
	// 原先写 document.querySelector("#expand-btn") 只绑到第一份，而移动端那份才是可见的，
	// 于是手机上点「更多」毫无反应（2026-09-30 在 375px 实测：两份 #category 都还是 collapsed）。
	// 规矩同五-29：挂两处的组件一律用 data 属性 + querySelectorAll，不用 id。
	document.querySelectorAll<HTMLElement>("[data-category-card]").forEach(card => {
		const btn = card.querySelector<HTMLElement>("[data-category-expand]")
		const list = card.querySelector<HTMLElement>("[data-category-list]")
		btn?.addEventListener("click", () => {
			list?.classList.remove("collapsed")
			btn.classList.add("hidden")
		})
	})
</script>
