<script>
    // 注意：不能用 define:vars 传配置——那会把脚本内联进每页 HTML，swup bundle 随之重复嵌入
    import { effectsConfig } from "@/config/effectsConfig"
    import Swup from "swup"

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    if (effectsConfig.pageTransition && !reduced) {
        document.documentElement.style.setProperty("--transition-duration", `${effectsConfig.duration}ms`)

        const swup = new Swup({
            containers: ["#swup-container"],
            animateHistoryBrowsing: true,
            // 等待集合照搬参考站：只认 .transition-swup-* 这类专用载体（本项目 = #banner-overlay-container）。
            // 默认 [class*="transition-"] 会命中全站 Tailwind transition-* 类，display:none 子树里冻住
            // 不过结束的过渡会让 visit 死锁（2026-09-23 实测）
            animationSelector: '[class*="transition-swup-"]',
        })
        window.swup = swup

        // 重跑容器内脚本（评论/分享/推荐位 + Astro 岛）。不用 @swup/scripts-plugin：它默认 scope 是整个
        // document，连容器外、永不被替换的 Header/侧栏脚本也一起重新插入执行，于是每次导航都给同一批元素
        // 再叠一层 addEventListener —— 实测切一次页后汉堡按钮「一次点击 = 两次 toggle」净零，看起来点不开；
        // 主题按钮同理，另外两个顶层 const 的经典内联脚本重执行还会各抛一条 SyntaxError。
        // 容器外的组件靠下面的桥接事件自恢复，不依赖重执行。
        swup.hooks.on("content:replace", () => {
            document
                .querySelectorAll("#swup-container script:not([data-swup-ignore-script])")
                .forEach((old) => {
                    const fresh = document.createElement("script")
                    for (const { name, value } of old.attributes) fresh.setAttribute(name, value)
                    fresh.textContent = old.textContent
                    old.replaceWith(fresh)
                })
        })

        // 切页进度条：WAAPI 驱动，数值照搬参考站的 startProgressBar / finishProgressBar
        const progressBar = () => document.getElementById("progress-bar")
        const startProgressBar = () => {
            const el = progressBar()
            if (!el) return
            el.getAnimations().forEach(a => a.cancel())
            el.animate([{ transform: "scaleX(0)", opacity: 1 }, { transform: "scaleX(0.95)", opacity: 1 }], {
                duration: 8000,
                easing: "cubic-bezier(0.1, 0.05, 0.1, 1)",
                fill: "forwards",
            })
        }
        const finishProgressBar = () => {
            const el = progressBar()
            if (!el) return
            el.getAnimations().forEach(a => a.cancel())
            el.animate([{ transform: "scaleX(1)", opacity: 1 }, { transform: "scaleX(1)", opacity: 0 }], {
                duration: 500,
                easing: "ease-out",
                fill: "forwards",
            })
        }

        // 点当前页自身的链接（如已选中某个分类再点一次）：不走 Swup、不瞬跳，平滑滚回顶部
        document.addEventListener(
            "click",
            e => {
                const a = (e.target as Element).closest?.("a[href]")
                if (!a) return
                if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
                if (a.target && a.target !== "_self") return
                const url = new URL(a.getAttribute("href") || "", location.href)
                if (url.origin !== location.origin || url.hash) return
                if (url.pathname + url.search !== location.pathname + location.search) return
                e.preventDefault()
                e.stopPropagation()
                window.scrollTo({ top: 0, behavior: "smooth" })
            },
            { capture: true }
        )

        swup.hooks.on("link:click", () => {
            document.documentElement.style.setProperty("--content-delay", "0ms")
            document.documentElement.classList.add("is-page-transitioning")
            // 导航栏若因向下滚动而收起，点击后立刻放回，别让它带着隐藏态进入新页
            const nav = document.getElementById("nav")
            if (nav) nav.style.transform = ""
        })

        // 回顶放在 visit:start（与点击同一个任务、下一帧绘制之前），浏览器永远不会画出
        // "旧页滚到一半"的样子。之前把回顶留在淡出窗口里，横幅静止不动时就会看到整屏跳一下
        swup.hooks.on("visit:start", visit => {
            startProgressBar()
            if (window.innerWidth >= 768) window.scrollTo({ top: 0, behavior: "instant" })

            // 首页↔非首页：横幅高度在两套变量间切换，过渡类只在切页期间挂上（照搬参考站）
            const targetPath = new URL(visit.to.url, window.location.href).pathname
            const targetIsHome = targetPath === "/" || /^\/\d+\/$/.test(targetPath)
            if (document.body.classList.contains("is-home") !== targetIsHome) {
                document.documentElement.classList.add("is-wallpaper-transitioning")
                document.body.classList.toggle("is-home", targetIsHome)
            }
        })

        swup.hooks.on("visit:end", () => {
            finishProgressBar()
            window.setTimeout(() => document.documentElement.classList.remove("is-page-transitioning"), 200)
            // 高度过渡 450ms，等它跑完再摘类，否则 transition 属性被撤掉会瞬间跳变
            window.setTimeout(() => document.documentElement.classList.remove("is-wallpaper-transitioning"), 500)
        })

        // 桥接：仓库里 12 个组件监听 Swup 3 旧名与 Astro VT 事件名，Swup 4 均不派发，见
        // docs/superpowers/specs/2026-09-23-page-transitions-design.md 的影响域分析
        const fire = (name: string) => document.dispatchEvent(new CustomEvent(name))
        swup.hooks.on("content:replace", () => fire("swup:contentReplaced"))
        swup.hooks.on("page:view", () => {
            fire("astro:page-load")
            fire("astro:after-swap")
        })
    }

    if (effectsConfig.windowResize && !reduced) {
        // 拖拽期间冻结布局宽度，松手后用 View Transitions 一次性 morph 到新布局。
        // 断点跨越改的是 grid 轨道数量与 sidebar 的 display，CSS transition 插值不了，
        // 只有"冻结 → 快照 → 应用新布局"才能让它有动画（Firefly 本体也没做这块）
        const root = document.documentElement
        let frozen = false
        let timer = 0
        // 只认宽度变化：morph 只为跨断点（grid 轨道数 / sidebar display 改变）而存在。
        // 手机地址栏收起/展开只改高度却会触发 resize，若照旧 freeze+startViewTransition，
        // 滚动中会反复整页快照交叉淡化 → 重影、旧快照与新页面叠印（2026-09-24 手机实测）
        let lastWidth = window.innerWidth
        const shell = () => document.getElementById("page-shell")
        const freeze = () => {
            const el = shell()
            // 零尺寸视口（隐藏标签页等）下取到的宽度是 0，冻结会把布局塌缩，跳过
            if (!el || frozen) return
            const w = getComputedStyle(el).width
            if (!w || w === "0px") return
            el.style.width = w
            frozen = true
        }
        const unfreeze = () => {
            const el = shell()
            if (el) el.style.width = ""
            frozen = false
        }
        window.addEventListener(
            "resize",
            () => {
                const w = window.innerWidth
                if (w === lastWidth) return
                lastWidth = w
                // Swup visit 飞行中不干预，避免与页面过渡打架
                if (root.classList.contains("is-changing")) return
                if (!frozen) freeze()
                root.setAttribute("data-resizing", "")
                clearTimeout(timer)
                timer = window.setTimeout(() => {
                    if (typeof document.startViewTransition === "function") {
                        const vt = document.startViewTransition(() => unfreeze())
                        vt.finished.finally(() => root.removeAttribute("data-resizing"))
                    } else {
                        unfreeze()
                        root.removeAttribute("data-resizing")
                    }
                }, 180)
            },
            { passive: true },
        )
    }
</script>
