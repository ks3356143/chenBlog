---
import { createHash } from "node:crypto"
import { readFileSync } from "node:fs"
import "@/styles/global.css" // tailwind覆盖所有
import "@/styles/main.css"
import "@/styles/transitions.css"
import "@/styles/layout-style.css"
import "@/styles/singles/abutton.css"
import "@/styles/waves.css"
import "@/styles/singles/mainSingles.css"
import "@/styles/markdown.css"
import "@/styles/toc.css"
// 导入Callouts插件主题
import "@rehype-callouts-theme"
// 导入github卡片样式
import "@/styles/markdown-extend.styl"
// 图片查看器
import FancyboxManager from "@/components/features/FancyboxManager.astro"
// 页面过渡 / 窗口缩放动画管理器
import SwupManager from "@/components/features/SwupManager.astro"
// SEO
import SEO, { type PageSEO } from "@/components/SEO.astro"
import { siteConfig } from "@/config/siteConfig"

interface Props extends PageSEO {
    title: string
}

const { title } = Astro.props

// 文档标题统一带品牌短名后缀（2026-10-14 用户拍板「全站 title 带后缀」）。
// 只在文档 <title> 上加：og:title 与 JSON-LD 的 headline 仍是内容原标题（社交卡片与富结果
// 要的是文章名，不是「文章名-站名」）。首页传进来的已经是品牌全名「亦林 YILIn」、
// 归档/分类/标签/系列/分页页也已经是「XX-亦林」→ 含「亦林」就不重复加。
const brandShort = "亦林"
const documentTitle = title
    ? title.includes(brandShort)
        ? title
        : `${title}-${brandShort}`
    : siteConfig.siteMeta.name

// 首页（含 /2/ 这类分页）横幅用高的一套高度变量，切页时做高矮过渡，见 layout-style.css
const pathname = Astro.url.pathname
const isHome = pathname === "/" || /^\/\d+\/$/.test(pathname)

// reinit.js 是「稳定文件名 + 内容会变」的脚本，而 Nginx 给它的是宝塔默认 js/css 的 max-age=43200（12h）：
// 改了 helper 之后回访用户会带着旧 helper 跑新 HTML（正是六节给 /pagefind/ 设 no-cache 要防的错位）。
// 用内容哈希当查询串，改一次文件就换一次 URL，不动服务器配置也能让改动立刻生效。
// ⚠️ 路径按 process.cwd() 拼，别用 import.meta.url：预渲染阶段这个模块在 dist/.prerender/chunks/ 里，
//    相对它去找 ../../public/ 会指到 dist/public/（实测直接 ENOENT 把构建打挂）。
const reinitVersion = createHash("sha256")
    .update(readFileSync(`${process.cwd()}/public/assets/js/reinit.js`))
    .digest("base64url")
    .slice(0, 10)
---

<!doctype html>
<html lang="zh-Hans-CN" class="bg-(--page-bg)">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <!-- sitemap -->
        <link rel="sitemap" href="/sitemap-index.xml" />
        <!-- C5：给 LLM / 阅读器自动发现的纯文本站点索引（2026-11-15 第五十七批） -->
        <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <!-- A2：地址栏/状态栏取色（安卓 Chrome、Edge、部分桌面浏览器）。
             ⚠️ 只能是**单值**、由下面那段脚本按 data-theme 改写 content——
                写两条 media="(prefers-color-scheme: dark)" 的会被「跟随系统」之外的
                手动切主题绕过去（用户选了暗色但系统是亮色 → 地址栏还是亮的）。
                 初值取亮色，脚本同步执行会在首帧前改掉，不会闪。 -->
        <meta name="theme-color" id="theme-color-meta" content="#e9f1ed" />
        <meta name="generator" content={Astro.generator} />
        <title>{documentTitle}</title>
        <SEO {...Astro.props} />
        <!-- 「导航后重 init」注册表：必须在 body 之前同步执行——容器内的 is:inline 脚本在解析期就要拿到 window.onReinit -->
        <script is:inline src={`/assets/js/reinit.js?v=${reinitVersion}`}></script>
        <script is:inline>
            // 主题解析与落盘（2026-11-24 第五十八批 A1 修缺陷）。
            //
            // 🔴 改前两个真缺陷（实测取证，别再改回去）：
            //   ① `localStorage.setItem("theme", theme)` 把**推导出来的值**也写回存储 →
            //      首次访问时系统是暗色就被钉成 "dark"，之后系统切成亮色也永远不跟。
            //      「跟随系统」实际只生效一次。现在**只在用户显式点选时写**，没存值 = 跟随系统。
            //   ② 全站没有一处监听 `prefers-color-scheme` 变化 → 页面开着时切系统主题毫无反应。
            //      现在挂一个 change 监听，且只在「没有显式选择」时才跟随（用户选过就别抢）。
            //
            // ⚠️ 整段包在 IIFE 里：is:inline 是经典脚本，顶层 const 会变成全局词法绑定，
            //    与 ThemeIcon 那段的 `setToggleListener` 同族（十-11 抛过 setTheme 重复声明）。
            // ⚠️ 仍然必须保持同步执行（head 里、body 之前）——晚一拍就是白屏闪烁。
            ;(function () {
                var KEY = "theme"
                var COLOR = { light: "#e9f1ed", dark: "#080f0c" } // 与 global.css 的 --page-bg 同值

                function readSaved() {
                    try {
                        var v = window.localStorage.getItem(KEY)
                        return v === "light" || v === "dark" ? v : null
                    } catch (e) {
                        return null // 隐私模式 / 禁用存储：当没选过，跟随系统
                    }
                }

                function prefersDark() {
                    try {
                        return window.matchMedia("(prefers-color-scheme: dark)").matches
                    } catch (e) {
                        return false
                    }
                }

                // 显式选择优先，否则跟随系统
                function resolveTheme() {
                    return readSaved() || (prefersDark() ? "dark" : "light")
                }

                function applyTheme() {
                    var theme = resolveTheme()
                    document.documentElement.setAttribute("data-theme", theme)
                    // A2：安卓 Chrome/Edge 的地址栏与状态栏读这个 meta，不补就永远是默认色
                    var meta = document.getElementById("theme-color-meta")
                    if (meta) meta.setAttribute("content", COLOR[theme] || COLOR.light)
                    return theme
                }

                // 给 ThemeToggle / DisplaySettings 用：它们改完存储后调一次，避免各写一套
                window.__applyTheme = applyTheme
                window.__resolveTheme = resolveTheme

                applyTheme()
                document.addEventListener("astro:after-swap", applyTheme)

                try {
                    var mq = window.matchMedia("(prefers-color-scheme: dark)")
                    var onSchemeChange = function () {
                        // 用户显式选过亮/暗 → 不跟随系统，避免"我选了暗色它自己变亮"
                        if (!readSaved()) applyTheme()
                    }
                    if (typeof mq.addEventListener === "function") mq.addEventListener("change", onSchemeChange)
                    else if (typeof mq.addListener === "function") mq.addListener(onSchemeChange) // Safari < 14
                } catch (e) {
                    /* 没有 matchMedia 就停在首次解析的结果上，不影响可用性 */
                }
            })()
        </script>
        <!-- 插槽：katex选择性加载css -->
        <slot name="head" />
    </head>
    <body class:list={{ "is-home": isHome }}>
        <!-- 跳转到主内容（无障碍 A 级，WCAG 2.4.1）。
             键盘用户第一个 Tab 就能跳过整个顶部导航与分类栏，直接进正文；
             鼠标用户永远看不到它 —— 它默认 `sr-only`，只有 :focus-visible 时才浮出来。
             ⚠️ 目标是 #swup-container（<main>），不是 #content-wrapper：后者会被 Swup 换掉，
               而 #swup-container 在容器名单里始终存在，软导航后跳转依然有效。 -->
        <a href="#swup-container" class="skip-to-content">跳到主要内容</a>
        <!-- 噪点质感层（2026-11-11 A3）：全屏一层极淡的胶片颗粒。
             ⚠️ 用 SVG feTurbulence 现画，**零额外请求**（base64 PNG 要 ~2KB 且进不了 CSS 缓存）；
                也**不是**每帧动画 —— 静态噪声本身就够，动起来会明显耗 GPU。
             ⚠️ `pointer-events: none` 必须有，否则整站点不到东西。
             ⚠️ 透明度只有 0.022（亮）/ 0.03（暗）：目标是"感觉有质感"而不是"看得见噪点"。
                 调大一点立刻变脏 —— 实测 0.05 就已经像低画质截图。 -->
        <div class="noise-overlay" aria-hidden="true"></div>
        <slot />
        <!-- Fancybox图片查看器-管理器 -->
        <FancyboxManager />
        <!-- 页面过渡 / 窗口缩放动画 -->
        <SwupManager />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
