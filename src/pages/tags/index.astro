---
import { Icon } from "astro-icon/components"
import Layout from "@/layouts/Layout.astro"
import ButtonTag from "@/components/commons/ButtonTag.astro"
import { getTagList } from "@/utils/content-utils"
import { getTagUrl } from "@/utils/url-utils"

const tags = await getTagList()
// 篇数最多的前 10 个标签，进度条按最大篇数归一
const topTags = [...tags].sort((a, b) => b.count - a.count).slice(0, 10)
const topMaxCount = topTags.length > 0 ? topTags[0].count : 1
---

<Layout title="标签-Yilin">
	<div class="card-base px-8 py-6 mb-4">
		<div class="text-2xl font-bold text-(--primary) mb-2">标签</div>
		<p class="text-30 text-sm">全部标签 · {tags.length} 个</p>
	</div>

	{
		tags.length > 0 ? (
			<div class="card-base px-8 py-6 mb-4">
				<div class="flex flex-wrap gap-2.5">
					{tags.map((t) => (
						<ButtonTag href={getTagUrl(t.name)} label={`查看标签 ${t.name} 的文章`}>
							{t.name.trim()}
							<span class="ml-1.5 text-xs font-bold text-(--btn-content)">{t.count}</span>
						</ButtonTag>
					))}
				</div>
			</div>
		) : (
			<div class="card-base px-8 py-12 text-center">
				<Icon name="material-symbols:tag-rounded" class="text-5xl text-30 mx-auto mb-4" />
				<p class="text-30">还没有标签</p>
			</div>
		)
	}

	{
		topTags.length > 0 && (
			<div class="card-base px-8 py-6">
				<h2 class="text-lg font-bold text-75 mb-4">Top 10</h2>
				<div class="flex flex-col gap-3">
					{topTags.map((t, i) => (
						<a
							href={getTagUrl(t.name)}
							class="group -mx-3 flex items-center gap-3 rounded-lg px-3 py-2 transition-colors hover:bg-(--btn-card-bg-hover)"
						>
							<span class="w-5 shrink-0 text-right text-sm font-bold text-(--primary)">{i + 1}</span>
							<div class="min-w-0 flex-1">
								<div class="mb-1 flex items-center justify-between">
									<span class="truncate text-sm font-medium text-50 transition-colors group-hover:text-(--primary)">
										#{t.name.trim()}
									</span>
									<span class="ml-2 shrink-0 text-xs text-(--primary)">{t.count} 篇文章</span>
								</div>
								<div class="h-2 overflow-hidden rounded-full bg-(--primary)/10">
									<div
										class="h-full rounded-full bg-(--primary) transition-all duration-500"
										style={`width: ${(t.count / topMaxCount) * 100}%`}
									/>
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		)
	}
</Layout>
