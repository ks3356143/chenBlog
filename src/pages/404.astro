---
import { Icon } from "astro-icon/components"
import Layout from "@/layouts/Layout.astro"
import { siteConfig } from "@/config/siteConfig"
import { url } from "@/utils/url-utils"

// ⚠️ 本页产物是 dist/404.html（Astro 对单文件页直接出 <name>.html，不是目录页），
//    但 Astro.url.pathname 在构建期是 `/404/` → 照默认值生成的 canonical/og:url 会指向
//    一个**真实返回 404 的 URL**（2026-10-17 复验抓出来的，我自己引入的缺陷）。
//    所以这里显式传真实可访问的绝对 URL。
const selfUrl = new URL("/404.html", Astro.site ?? siteConfig.site_url).href

// 站内 404 页。
// ⚠️ 两个已知边界，别以为写完就全好了：
// ① Nginx 的 vhost 里 `#error_page 404/404.html;` 目前是**注释状态** → 要让访客真的看到这一页，
//    需要在宝塔那个 vhost 放开这一行（属服务器改动，要用户当次点头，见 AGENTS 六节）。
//    现在这页已经作为静态产物存在，`/404.html` 直接访问是 200，改完 nginx 立刻生效、不用再部署。
// ② 纯静态 SSG 里 `Astro.redirect("/404/")` 那几处（关页面开关的分支）不会走到这里——
//    它不产出 404.html，语义也和 SSR 不同。这条与本页无关，别顺手"修"。
const homeUrl = url("/")
const links = [
	{ name: "首页", href: homeUrl, icon: "home", desc: "回到文章列表" },
	{ name: "归档", href: url("/archive/"), icon: "archive", desc: "按年份翻完全部文章" },
	{ name: "分类", href: url("/categories/"), icon: "material-symbols:folder-open-rounded", desc: "按主题挑" },
	{ name: "项目", href: url("/projects/"), icon: "material-symbols:widgets-rounded", desc: "做过的东西" },
	{ name: "相册", href: url("/gallery/"), icon: "xiangce", desc: "生活那边的内容" },
	{ name: "关于", href: url("/about/"), icon: "about", desc: "站主是谁" },
]
---

<Layout title="页面不存在-亦林" url={selfUrl}>
	<!-- 本页**天然不进 Pagefind 索引**，真实机制（2026-10-17 查清）：
	     `Markdown.astro` 只在文章/单页正文上放 `data-pagefind-body`，而 Pagefind 一旦在站内
	     发现任何 body 标记，就**只索引带该标记的页**、其余整页忽略（本站 30 页索引 / 15 页不索引，
	     首页与归档/分类/标签/系列/相册都在不索引那批）。本页没走 <Markdown> → 自动不索引。
	     下面这个 data-pagefind-ignore 只是**第二道兜底**（万一将来有人给这页加 body 标记）。
	     ⚠️ 别把它当成「404 不进索引」的原因——那是错的因果，曾写进分册，已更正。 -->
	<div data-pagefind-ignore class="relative flex min-h-32 w-full overflow-hidden">
		<div class="card-base relative z-10 w-full px-9 py-8">
			<div class="mb-6 flex items-center gap-3">
				<div
					class="flex h-8 w-8 items-center justify-center rounded-lg bg-(--primary) text-white dark:text-black/70"
				>
					<Icon name="material-symbols:search-off" class="text-[1.5rem]" />
				</div>
				<!-- 本站口径：可见大标题是 div，语义 h1 由 Layout 注入的 sr-only 承担（同 guestbook / gallery）。
				     ⚠️ 这段注释里**别出现那个标签的字面尖括号写法**——注释会原样进产物，
				     将来用 grep 数一级标题标签的个数来验「每页恰好一个」，会被这条注释自己骗到
				     （同 PostCard 那条占位文案的教训，那边是靠改注释措辞解决的）。
				     这里再写一个真的可见标题就变成两个非空标题，违反五-13 -->
				<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">这个页面走丢了</div>
			</div>

			<p class="mb-1 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
				你访问的地址在本站找不到对应的内容（404）。可能是文章改过 URL、链接被截断，或者地址本来就写错了。
			</p>
			<p class="mb-7 text-sm leading-relaxed text-neutral-500 dark:text-neutral-500">
				如果确定是从站内某个链接点进来的，告诉我一声，我把那条链接补上。
			</p>

			<div class="mb-7 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{
					links.map(l => (
						<a
							href={l.href}
							class="btn-card group flex items-center gap-3 px-4 py-3 active:scale-[0.98]"
							aria-label={`去${l.name}`}
						>
							<Icon name={l.icon} class="shrink-0 text-xl text-(--primary)" />
							<span class="min-w-0 flex-1">
								<span class="block truncate text-sm font-bold text-black/75 transition group-hover:text-(--primary) dark:text-white/75">
									{l.name}
								</span>
								<span class="block truncate text-xs text-black/35 dark:text-white/35">{l.desc}</span>
							</span>
							<Icon
								name="material-symbols:chevron-right-rounded"
								class="shrink-0 text-xl text-black/15 transition group-hover:translate-x-0.5 group-hover:text-(--primary) dark:text-white/15"
							/>
						</a>
					))
				}
			</div>

			<!-- B4（2026-11-24 第五十八批）：本页自带搜索框 + 随机一篇。
			     改前这里只有一句「也可以在顶栏那排输入框里直接搜关键词」——让人自己去顶栏找，
			     而访客正是在这页最需要搜索的时候。搜索走后端 Pagefind 索引，零新增依赖：
			     输入框只负责收集关键词，提交后派发 blog:search-with，由 Search.svelte 统一
			     打开结果面板（全站「打开搜索」只有那一处实现，别再写第二套）。
			     ⚠️ 本页是 dist/404.html、不走 Swup，但按钮仍用事件委托 + 运行时读取，
			        这样即使将来被当普通页软导航进来也不会重复绑监听。 -->
			<div class="mb-7 border-t border-dashed border-(--line-divider) pt-6">
				<form id="nf-search-form" class="flex items-stretch" role="search" autocomplete="off">
					<label for="nf-search-input" class="sr-only">站内搜索</label>
					<input
						id="nf-search-input"
						type="text"
						inputmode="search"
						placeholder="搜点别的？输入关键词，回车"
						class="h-11 min-w-0 flex-1 border border-(--line-divider) bg-transparent px-3 text-sm outline-none placeholder:text-30 focus:border-(--primary)"
					/>
					<button
						type="submit"
						class="btn-regular h-11 shrink-0 cursor-pointer border border-(--line-divider) px-4 active:scale-[0.98]"
					>
						<Icon name="material-symbols:search" class="text-lg" />
					</button>
				</form>
				<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
					<button
						type="button"
						id="nf-random-post"
						class="btn-plain h-9 cursor-pointer border border-(--line-divider) px-3 text-sm active:scale-[0.98]"
					>
						<Icon name="material-symbols:casino" class="mr-1 text-lg" />
						<span>随便看一篇</span>
					</button>
					<span class="text-xs text-neutral-400 dark:text-neutral-500">从已发布文章里随机挑一篇</span>
				</div>
			</div>

			<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-neutral-500 dark:text-neutral-400">
				<button
					type="button"
					class="btn-regular cursor-pointer px-4 py-2 active:scale-[0.98]"
					id="nf-back"
				>
					返回上一页
				</button>
			</div>
		</div>
	</div>

	<!-- B4 交互（2026-11-24 第五十八批）。必须写在 <Layout> 里面：
	     Layout 自己输出完整的 <html>…</html>，放它后面脚本会落到 </html> 之后（浏览器容忍但结构不合法）。
	     两条都挂 document 上、用 reinitOnce 只挂一次；
	     用事件委托而不是回到具体节点，这样即使将来被当普通页软导航进来也不会重复绑定。 -->
	<script is:inline>
		window.reinitOnce("nf-actions", function () {
			// pickRandomPost 收在回调里，不往全局丢函数名（软导航重入时也不会重复声明）
			function pickRandomPost(btn) {
				function go(all) {
					if (!all || !all.length) return
					// 排除加密文章（纯静态站里 password 只隐藏评论区，但推荐位一贯排除它）
					var pool = all.filter(function (p) {
						return p && p.id && !p.password
					})
					if (!pool.length) pool = all
					var pick = pool[Math.floor(Math.random() * pool.length)]
					location.href = "/posts/" + pick.id + "/"
				}
				if (window.__allPostMetaCache) {
					go(window.__allPostMetaCache)
					return
				}
				btn.disabled = true
				fetch("/api/allPostMeta.json")
					.then(function (r) {
						return r.json()
					})
					.then(function (data) {
						window.__allPostMetaCache = data
						go(data)
					})
					.catch(function () {
						btn.disabled = false
					})
			}

			document.addEventListener("submit", function (e) {
				var form = e.target
				if (!form || form.id !== "nf-search-form") return
				e.preventDefault()
				var input = document.getElementById("nf-search-input")
				var word = input && input.value ? input.value.trim() : ""
				if (!word) {
					if (input) input.focus()
					return
				}
				// 交给 Search.svelte 的收口：它会开面板、灌关键词并聚焦输入框
				document.dispatchEvent(new CustomEvent("blog:search-with", { detail: { query: word } }))
			})

			document.addEventListener("click", function (e) {
				var t = e.target
				var btn = t && t.closest ? t.closest("#nf-random-post") : null
				if (btn) {
					e.preventDefault()
					pickRandomPost(btn)
					return
				}
				var back = t && t.closest ? t.closest("#nf-back") : null
				if (back) {
					e.preventDefault()
					// 与改前的内联 onclick 行为一致：有历史就退，没有就回首页
					if (history.length > 1) history.back()
					else location.href = "/"
				}
			})
			return true
		})
	</script>
</Layout>
