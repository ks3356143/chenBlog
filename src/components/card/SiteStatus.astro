---
import { siteConfig } from "@/config/siteConfig"
import { getCategoryList, getSortedPosts, getTagList } from "@/utils/content-utils"
import { Icon } from "astro-icon/components"

// 从站点配置获取开始时间
const siteStartDate = siteConfig.siteStartDate || "2026-01-01"

// 获取所有文章
const posts = await getSortedPosts()
const categories = await getCategoryList()
const tags = await getTagList()

// 计算总字数
let totalWords = 0
for (const post of posts) {
	if (post.body) {
		// 移除代码块和内联代码后计算字数
		let text = post.body
			.replace(/```[\s\S]*?```/g, "") // 移除代码块
			.replace(/`[^`]*`/g, "") // 移除内联代码
			.replace(/\s+/g, " ") // 合并空白
			.trim()

		// 分别计算中文字符和英文字符
		const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || []
		const englishChars = text.match(/[a-zA-Z]/g) || []

		totalWords += chineseChars.length + englishChars.length
	}
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString()
}

// 获取最新文章日期（用于客户端计算）
const latestPost = posts.reduce((latest, post) => {
	if (!latest) return post
	return post.data.published > latest.data.published ? post : latest
}, posts[0])
const lastPostDate = latestPost ? latestPost.data.published.toISOString() : null

const todayText = "今日"
const stats = [
	{
		icon: "material-symbols:article-outline",
		label: "文章",
		value: posts.length,
	},
	{
		icon: "material-symbols:folder-outline",
		label: "分类",
		value: categories.length,
	},
	{
		icon: "material-symbols:label-outline",
		label: "标签",
		value: tags.length,
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: "总字数",
		value: totalWords,
		formatted: true,
	},
	{
		icon: "material-symbols:calendar-clock-outline",
		label: "运行时长",
		value: 0, // 将由客户端更新
		suffix: "天",
		dynamic: true,
		id: "running-days",
	},
	{
		icon: "mingcute:heartbeat-line",
		label: "最后活动",
		value: 0, // 将由客户端更新
		suffix: "天前",
		dynamic: true,
		id: "last-update",
	},
]
---

<!--
	⚠️ 配置值走 data- 属性，不用 `define:vars`（十-3）：
	本组件在 Layout.astro:182 与 RightSideBar.astro:24 **各挂一次**，而 `define:vars` 会把整段
	脚本体跟着组件**内联两遍**（实测首页两份 1523 字节、哈希完全相同）—— 白多 1.5KB/页，
	且两份脚本各自注册 onReinit 同一 key。改挂 data- 后脚本体不再是内联脚本，
	Astro 只收一次；两个实例各自把自己的值带在根节点上，脚本按 closest 找。
	⚠️ 这段注释里**不能出现 script 开标签字样**：Astro 的解析器会把注释里的它当真标签，
	把后面整段模板当脚本吞进去（实测首页内联块从 11.8KB 膨胀到 12.2KB + 6.8KB 两块）。
-->
<div
	class="card-base pb-4"
	data-site-status
	data-start-date={siteStartDate}
	data-last-post={lastPostDate || ""}
	data-today-text={todayText}
>
	<div class="card-title">站点统计</div>
	<div class="overflow-hidden px-4">
		<div class="flex flex-col gap-2">
			{
				stats.map(stat => (
					<div class="flex items-center justify-between px-3 py-1.5">
						<div class="flex items-center gap-2.5">
							<div class="text-xl text-(--primary)">
								<Icon name={stat.icon} />
							</div>
							<span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">{stat.label}</span>
						</div>
						<div class="flex items-center">
							<span
								class="text-base font-bold text-neutral-900 dark:text-neutral-100"
								data-stat-id={stat.id}
							>
								{stat.formatted ? formatNumber(stat.value) : stat.value}
							</span>
							{stat.suffix && (
								<span class="ml-1 text-sm text-neutral-500 dark:text-neutral-400">{stat.suffix}</span>
							)}
						</div>
					</div>
				))
			}
		</div>
	</div>
</div>

<script>
	// 配置从根节点的 data- 属性读（见模板顶部注释：本组件一页挂两处，define:vars 会内联两遍）。
	// 每次调用都重新查 DOM（容器会被 Swup 整片换掉，闭包里抓旧节点会指到已移除的元素）。
	function updateDynamicStats() {
		const roots = document.querySelectorAll<HTMLElement>("[data-site-status]")
		if (!roots.length) return

		const today = new Date()

		// 更新运行天数：每处实例用自己的 data-start-date（两处值本来相同，但别假设）
		roots.forEach(root => {
			const startRaw = root.dataset.startDate || "2026-01-01"
			const startDate = new Date(startRaw)
			const diffTime = Math.abs(today.getTime() - startDate.getTime())
			const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24))
			root.querySelectorAll<HTMLElement>('[data-stat-id="running-days"]').forEach(el => {
				el.textContent = diffDays.toString()
			})

			const lastRaw = root.dataset.lastPost
			if (!lastRaw) return
			const todayText = root.dataset.todayText || "今日"
			const lastPost = new Date(lastRaw)
			const timeSinceLastPost = Math.abs(today.getTime() - lastPost.getTime())
			const daysSinceLastUpdate = Math.floor(timeSinceLastPost / (1000 * 60 * 60 * 24))
			root.querySelectorAll<HTMLElement>('[data-stat-id="last-update"]').forEach(el => {
				if (daysSinceLastUpdate === 0) {
					el.textContent = todayText
					const sib = el.nextElementSibling as HTMLElement | null
					if (sib) sib.style.display = "none"
				} else {
					el.textContent = daysSinceLastUpdate.toString()
					const sib = el.nextElementSibling as HTMLElement | null
					if (sib) sib.style.display = ""
				}
			})
		})
	}

	// 首次 + 每次导航后重算
	window.onReinit("site-status", updateDynamicStats, { delay: 100 })
</script>