---
import { siteConfig } from "@/config/siteConfig"

export type PageSEO = {
    title?: string // 文章标题
    description?: string // 文章描述
    url?: string
    image?: {
        src: string
        alt: string
    }
    frontmatter?: Object
}

// og:image 必须是「本站 + 绝对 URL + 文件真实存在于 dist/」，社交爬虫不会解析相对路径。
// 站点级默认值现在只有 siteConfig.siteMeta 一处（原先散在 src/data/site.json，是模板遗留脏数据）。
const ogImage = new URL(siteConfig.siteMeta.ogImage, Astro.site ?? siteConfig.site_url).href

const {
    title = siteConfig.siteMeta.name,
    description = siteConfig.siteMeta.description,
    url = Astro.url,
    image = { src: ogImage, alt: siteConfig.siteMeta.ogImageAlt },
    frontmatter, // 传入frontmatter
} = Astro.props

function jsonLDGenerator({ type, post, url }: any) {
    if (type === "post") {
        return `<script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "${url}"
        },
        "headline": "${post.title}",
        "description": "${post.description}",
        "image": "${typeof post.image === "string" && post.image ? post.image : ogImage}",
        "tag": "${post.tags}",
        "category":"${post.category}",
        "excerpt":"${post.excerpt}",
        "publish": "${post.published}",
        "updated":"${post.updated}",
      }
    </script>`
    }
    return `<script type="application/ld+json">
      {
      "@context": "https://schema.org/",
      "@type": "WebSite",
      "name": "${siteConfig.siteMeta.name}",
      "url": "${import.meta.env.SITE}"
      }
    </script>`
}

const jsonLD = jsonLDGenerator({
    type: frontmatter ? "post" : "website",
    post: frontmatter,
    url,
})
---

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title={siteConfig.siteMeta.name} href={new URL("rss.xml", Astro.site)} />

<!-- SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:site_name" content={siteConfig.siteMeta.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image?.src} />
<meta property="og:image:url" content={image?.src} />
<meta property="og:image:secure_url" content={image?.src} />
<meta property="og:image:type" content="image/jpeg" />
<!-- 尺寸对应 public/og-image.jpg（站头壁纸裁的 1200×630）。
     26 篇文章 frontmatter 的 image 全为空，所以实际永远走站点默认图；
     将来若给某篇传自定义 image，这里的宽高要改成随 image 走 -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={image?.alt} />

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image?.src} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:domain" content={import.meta.env.SITE} />

<!-- JSON LD -->
<Fragment set:html={jsonLD} />
