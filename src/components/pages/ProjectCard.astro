---
import { Icon } from "astro-icon/components"
import type { Project } from "@/config/projectsConfig"
import { statusMeta } from "@/config/projectsConfig"

interface Props {
	project: Project
}

const { project } = Astro.props

// 状态徽标：已发布 / 开发中用主色，计划中与已归档用中性色，避免一张卡片里三种高亮
const isActive = project.status === "published" || project.status === "developing"
const status = statusMeta[project.status]
---

<article
	class="project-card card-base group relative flex h-full flex-col p-5 transition-all duration-300 hover:shadow-md"
	data-status={project.status}
	data-name={(project.name + " " + project.description + " " + project.tech.join(" ")).toLowerCase()}
>
	<!-- 头部：图标 + 名称 + 状态徽标 -->
	<div class="mb-3 flex items-start gap-3">
		<div
			class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-(--btn-regular-bg) text-(--btn-content) transition"
		>
			<Icon name={project.icon || "material-symbols:widgets-rounded"} class="text-[1.75rem]" />
		</div>
		<div class="min-w-0 flex-1">
			{/* 标题与徽标同一行内基线对齐；标题允许换行（长名字如「CCNewTools 测试文档工具集」必然两行），
			    徽标 shrink-0 不被压扁、且**不再 flex-wrap** —— 原先 wrap 会让徽标被挤到自己一行，
			    三张卡的第一行高度因此不齐（截图实测）。 */}
			<div class="mb-1 flex items-baseline gap-2">
				<h2 class="min-w-0 text-lg leading-snug font-bold text-neutral-900 transition dark:text-neutral-100">
					{project.name}
				</h2>
				{
					project.featured && (
						<span
							class="mt-0.5 shrink-0 bg-(--primary) px-1.5 py-0.5 text-[0.65rem] font-medium text-white"
							title="重点推荐"
						>
							推荐
						</span>
					)
				}
			</div>
			<div class="flex items-center gap-1.5 text-xs">
				<Icon
					name={status.icon}
					class={isActive ? "text-[0.9rem] text-(--primary)" : "text-[0.9rem] text-neutral-400 dark:text-neutral-500"}
				/>
				<span class={isActive ? "font-medium text-(--primary)" : "text-neutral-500 dark:text-neutral-400"}>
					{status.label}
				</span>
				{project.year && <span class="text-neutral-400 dark:text-neutral-500">· {project.year}</span>}
			</div>
		</div>
	</div>

	<!-- 简介 -->
	<p class="mb-4 grow text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
		{project.description}
	</p>

	<!-- 技术栈 -->
	<div class="mb-4 flex flex-wrap gap-1.5">
		{
			project.tech.map(t => (
				<span class="bg-(--btn-regular-bg) px-2 py-0.5 text-[0.7rem] font-medium text-(--btn-content)">
					{t}
				</span>
			))
		}
	</div>

	<!-- 链接 -->
	<div class="flex flex-wrap gap-2 border-t border-(--line-divider) pt-3">
		{
			project.repo && (
				<a
					href={project.repo}
					target="_blank"
					rel="noopener"
					class="inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium text-(--primary) transition hover:opacity-80"
					aria-label={`${project.name} 源码仓库`}
				>
					<Icon name="github" class="text-[1rem]" />
					源码
				</a>
			)
		}
		{
			project.demo && (
				<a
					href={project.demo}
					target="_blank"
					rel="noopener"
					class="inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium text-(--primary) transition hover:opacity-80"
					aria-label={`${project.name} 在线演示`}
				>
					<Icon name="material-symbols:open-in-new-rounded" class="text-[1rem]" />
					演示
				</a>
			)
		}
	</div>
</article>
