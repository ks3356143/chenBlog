---
import type { GetStaticPaths } from "astro"
import { createHash } from "node:crypto"
import { readFileSync } from "node:fs"
import { render } from "astro:content"
import { getSortedPosts, getRelatedPosts, getSeriesPosts } from "@/utils/content-utils"
import Layout from "@/layouts/Layout.astro"
import Markdown from "@/components/commons/Markdown.astro"
import RecommendedPost from "@/components/layout/subcomps/RecommendedPost.astro"
import ReadingProgress from "@/components/features/ReadingProgress.astro"
import SeriesNav from "@/components/misc/SeriesNav.astro"
import { Icon } from "astro-icon/components"
import PostMeta from "@/components/layout/PostMeta.astro"
import CoverImage from "@/components/commons/CoverImage.astro"
import CopyShare from "@/components/commons/CopyShare.astro"
import { getPostUrlBySlug } from "@/utils/url-utils"
import { url } from "@/utils/url-utils"
import { hasMath } from "@/utils/math-utils"
import Comment from "@/components/comment/index.astro"

// 文章详情页面

// 生成页面函数
export const getStaticPaths = (async () => {
    const blogEntries = await getSortedPosts()
    return blogEntries.map((post) => {
        const slug = post.id
        return {
            params: { slug },
            props: { post },
        }
    })
}) satisfies GetStaticPaths

// 文章对象
const { post } = Astro.props

// 获取标题、内容与插件解析结果（一次 render 就全有了；此前分两次调，同一篇整条
// markdown 链跑了两遍，26 页各多付一次）
const { Content, headings, remarkPluginFrontmatter } = await render(post)

// 判断是否有Cover图
const hasImage = post.data.image ? true : false

// bannerPostMeta用于在文章页面替换打字机文字变为封面文字
const bannerPostMeta = {
    title: post.data.title,
    published: post.data.published,
    updated: post.data.updated,
    words: remarkPluginFrontmatter.words,
    minutes: remarkPluginFrontmatter.minutes,
}

// 获取相关文章和推荐文章
const relatedPosts = await getRelatedPosts(post, 5)

// 所属系列（未设 series 时为 null，不渲染系列导航盒）
const seriesData = await getSeriesPosts(post)

/* KaTeX 的 CSS 只在**这篇真有公式**时才加载（2026-11-11）。
   原先无条件加：33 篇文章里公式使用数是 **0**，但每页都白下 27.9KB CSS（gzip 7.8KB）
   + dist 里 19 个字体文件 250KB。判据在 src/utils/math-utils.ts，
   已拿 remark-math 的真实解析结果逐条对齐（15 个样例全一致）。
   ⚠️ 加了公式的文章会自动恢复加载，不需要任何额外操作。 */
const postHasMath = hasMath(post.body)

/* KaTeX CSS 在 public/vendor/katex/ 下是**稳定文件名**，吃宝塔 js/css 规则的 max-age=43200（12h）
   → 将来升级 katex 换了 CSS，回访用户 12 小时内还会拿旧的。用内容哈希当查询串即可，
   不动服务器配置（与 reinit.js 同一套做法，见十-14 末条）。
   ⚠️ 只有真有公式的页面才走这里，无公式页连读文件都不做。 */
const katexVersion = postHasMath
    ? createHash("sha256")
          .update(readFileSync(`${process.cwd()}/public/vendor/katex/katex.css`))
          .digest("base64url")
          .slice(0, 10)
    : ""
---

<Layout title={post.data.title} description={post.data.description || undefined} bannerPostMeta={bannerPostMeta} postSlug={post.id} headings={headings} frontmatter={remarkPluginFrontmatter}>
    <!-- KaTeX 的 CSS 只在正文真有公式时才加载。
         ⚠️ 走 public/ 静态 <link>，**不能**改成组件里 import CSS：
         2026-11-11 实测，Astro/Vite 会把被 import 的 CSS 无条件挂进该页产物
         （条件渲染、甚至 await import() 都拦不住，33/33 页照样引用）。
         字体只在页面上真出现字形时才下载，没公式的页面零请求。 -->
    {postHasMath && <link rel="stylesheet" href={`/vendor/katex/katex.css?v=${katexVersion}`} />}
    <!-- 阅读进度条：只在文章页存在 -->
    <ReadingProgress />
    <div class="relative mb-4 flex w-full flex-col overflow-hidden">
        <!-- 文章详情页面 -->
        <div id="post-container" class="card-base relative z-10 w-full px-6 pt-6 md:px-9">
            <!-- 头部添加阅读事件和字数 -->
            <div class="onload-animation mb-3 flex flex-row gap-5 text-black/50 transition dark:text-white/50">
                <div class="flex flex-row items-center">
                    <div
                        class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-black/10 text-black/50 transition dark:bg-white/20 dark:text-white/50"
                    >
                        <Icon name="material-symbols:notes-rounded" />
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.words} 字
                    </div>
                </div>
                <div class="flex flex-row items-center">
                    <div
                        class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-black/5 text-black/50 transition dark:bg-white/10 dark:text-white/50"
                    >
                        <Icon name="material-symbols:schedule-outline-rounded" />
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes} 分钟
                    </div>
                </div>
            </div>

            <!-- 文章标题 -->
            <div class="onload-animation relative">
                <div class="post-title-primary">
                    {post.data.title}
                </div>
            </div>

            <!-- 文章元数据展示 -->
            <div class="onload-animation">
                <PostMeta
                    className="mb-5"
                    published={post.data.published}
                    updated={post.data.updated}
                    tags={post.data.tags}
                    category={post.data.category || undefined}
                    hideUpdateDate={false}
                />
            </div>

            <!-- 所属系列导航盒 -->
            {
                seriesData && (
                    <SeriesNav seriesName={seriesData.seriesName} posts={seriesData.posts} currentPostId={post.id} />
                )
            }

            <!-- 文章封面：可无 -->
            {
                hasImage && (
                    <div style="margin-top:1rem;">
                        <CoverImage
                            id="post-cover"
                            src={post.data.image}
                            class="banner-container onload-animation mb-8 rounded-xl"
                            preview={false}
                        />
                    </div>
                )
            }

            <!-- Markdown渲染 -->
            <Markdown class="markdown-content onload-animation mb-6">
                <Content />
            </Markdown>

            <!-- 复制链接分享 -->
            <CopyShare postUrl={getPostUrlBySlug(post.id)} />
        </div>

        <!-- 上一篇文章和下一篇文章，使用data.prevSlug和data.nextSlug -->
        <div class="mt-4 mb-4 flex w-full flex-col justify-between gap-4 overflow-hidden md:flex-row">
            <a
                href={post.data.nextSlug ? getPostUrlBySlug(post.data.nextSlug) : url("/")}
                class="w-full overflow-hidden font-bold active:scale-95"
            >
                <div class="btn-card flex h-15 w-full max-w-full items-center justify-start! gap-4 px-4">
                    <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-(--primary)" />
                    <div
                        class="max-w-[calc(100%-3rem)] overflow-hidden text-ellipsis whitespace-nowrap text-black/75 transition dark:text-white/75"
                    >
                        {post.data.nextTitle || "首页"}
                    </div>
                </div>
            </a>

            <a
                href={post.data.prevSlug ? getPostUrlBySlug(post.data.prevSlug) : url("/")}
                class="w-full overflow-hidden font-bold active:scale-95"
            >
                <div class="btn-card flex h-15 w-full max-w-full items-center justify-end! gap-4 px-4">
                    <div
                        class="max-w-[calc(100%-3rem)] overflow-hidden text-ellipsis whitespace-nowrap text-black/75 transition dark:text-white/75"
                    >
                        {post.data.prevTitle || "首页"}
                    </div>
                    <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-(--primary)" />
                </div>
            </a>
        </div>

        <!-- 推荐和相关文章 -->
        <RecommendedPost relatedPosts={relatedPosts} currentPostId={post.id} />

        <!-- 评论 -->
        {post.data.comment && !post.data.password && <Comment />}
    </div>
</Layout>
