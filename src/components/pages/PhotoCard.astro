---
import { getPublicImageSizeSync } from "@/utils/image-size"
import { getGalleryDisplaySrc, getGallerySrcset, getGalleryThumbWidth } from "@/utils/gallery-thumb"

interface Props {
	src: string
	albumId: string
	alt?: string
	/**
	 * 这张就是相册封面（横幅已经用它、且是 eager 加载的原图）。
	 *
	 * 传 true 时**不走缩略图、直接用原图**：同一 URL 浏览器缓存已命中 → 额外下载 0 字节。
	 * 2026-10-18 实测理由：不给这个开关的话，横幅下原图（如 pujiangyintaoshan 的 447KB）、
	 * 瀑布流再下这张的缩略图（197KB）→ 该册总下载 766KB，比改造前的 762KB **还多 4KB**
	 * （改造前两处是同一个 URL，天然共享缓存）。开关一开就回到 0 额外成本。
	 */
	preferOriginal?: boolean
}

const { src, albumId, alt = "", preferOriginal = false } = Astro.props

// 补 width/height 治 CLS（相册图走 public/ 原样拷贝，构建期没有 ImageMetadata）。
// 解析不到就不写 —— 别猜数字。见 docs/agents/config.md 五-59。
const size = getPublicImageSizeSync(src)

// 网格用缩略图、灯箱用原图（data-src 保持原图 → 点开仍是高清）。
// sizes：瀑布流实测最宽 301px（1920 屏），窄屏是两列各约 156px。
// 写死一个 320px 会让手机两列（156px）也按 320 挑档 —— DPR2 下需要 312px，刚好卡在
// 640/960 之间选 640，白付一倍体积。分段写更准：
const displaySrc = preferOriginal ? src : getGalleryDisplaySrc(src)
const srcset = preferOriginal ? undefined : getGallerySrcset(src)
const thumbW = preferOriginal ? null : getGalleryThumbWidth(src)
const SIZES = "(min-width: 640px) 320px, 50vw"

// width/height 写**实际下发的缩略图**档位（不是原图）：等比缩放，比例完全相同，
// 只是把数字换成真实值 —— 混用（属性 1440 + sizes 320px + srcset 640w）实测会让
// Chromium 把 naturalWidth 报成第三个数字 320，属自相矛盾。见 gallery-thumb.ts 的注释。
const attrW = thumbW && size ? thumbW : size?.width
const attrH = thumbW && size ? Math.round((thumbW * size.height) / size.width) : size?.height
---

<div class="gallery-photo-card mb-3 break-inside-avoid">
	<div
		data-fancybox={`gallery-${albumId}`}
		data-src={src}
		data-type="image"
		class="group block cursor-pointer overflow-hidden"
	>
		<img
			src={displaySrc}
			srcset={srcset}
			sizes={srcset ? SIZES : undefined}
			alt={alt}
			width={attrW}
			height={attrH}
			loading="lazy"
			decoding="async"
			class="h-auto w-full object-cover transition-transform duration-300 group-hover:scale-105"
		/>
	</div>
</div>
