<script>
    // 注意：不能用 define:vars 传配置——那会把脚本内联进每页 HTML，swup bundle 随之重复嵌入
    import { effectsConfig } from "@/config/effectsConfig"
    import Swup from "swup"

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    if (effectsConfig.pageTransition && !reduced) {
        document.documentElement.style.setProperty("--transition-duration", `${effectsConfig.duration}ms`)

        const swup = new Swup({
            // 横幅文案层必须一起换：它带 .transition-swup-fade（animationSelector 的等待目标），
            // 但只有登记成 container 才会被替换。少这一项的表现是「切到文章页横幅还写着 Lovely Life，
            // 切回主页还挂着文章标题」——F5 才正常（2026-10-01 用户报，参考站 containers 里就有它）
            // #right-sidebar 也必须登记：右栏是 `isPostPage ? TOC : 日历` 的**二选一**，
            // 而它在 #swup-container 外面。不登记 = 软导航进文章页后右栏还挂着 35 格日历、
            // #sidebar-toc 根本不出现（2026-10-13 线上实测：navs:1 而 hasToc:false / hasCalendar:true），
            // 只有硬刷新才对。参考站的 containers 里同样有 #right-sidebar-dynamic。
            // ⚠️ 只加 #right-sidebar 不够：移动底部堆是另一个子树（Layout 的 #mobile-bottom-sidebar），
            //    侧栏那三张卡在那儿也各有一份，但那是 md:hidden、不参与 1280+ 的桌面布局，
            //    且它不在右栏容器内 → 由 reinit.js 的 onReinit 负责恢复（与登记前同一套机制）。
            containers: ["#banner-overlay-container", "#swup-container", "#right-sidebar"],
            animateHistoryBrowsing: true,
            // 等待集合照搬参考站：只认 .transition-swup-* 这类专用载体（本项目 = #banner-overlay-container）。
            // 默认 [class*="transition-"] 会命中全站 Tailwind transition-* 类，display:none 子树里冻住
            // 不过结束的过渡会让 visit 死锁（2026-09-23 实测）
            animationSelector: '[class*="transition-swup-"]',
        })
        window.swup = swup

        // 重跑容器内脚本（评论/分享/推荐位 + Astro 岛 + 右栏的 TOC）。不用 @swup/scripts-plugin：
        // 它默认 scope 是整个 document，连容器外、永不被替换的 Header/侧栏脚本也一起重新插入执行，
        // 于是每次导航都给同一批元素再叠一层 addEventListener —— 实测切一次页后汉堡按钮
        // 「一次点击 = 两次 toggle」净零，看起来点不开；主题按钮同理，另外两个顶层 const 的
        // 经典内联脚本重执行还会各抛一条 SyntaxError。容器外的组件靠下面的桥接事件自恢复，
        // 不依赖重执行。
        // ⚠️ 选择器必须覆盖**所有**登记成 container 的元素：2026-10-13 把 #right-sidebar 也登记成
        // container 之后，这里仍只扫 #swup-container → SiderBarToc 的 type="module" 脚本不被重新插入、
        // 它的 onReinit("sidebar-toc") 一次都没注册 → 软导航进文章页右栏只剩空的「目录」标题
        // （实测 tocContentChildren=0、reinitRuns("sidebar-toc")=-1）。
        const CONTAINER_SELECTOR = ["#swup-container", "#right-sidebar", "#banner-overlay-container"]
            .map((s) => `${s} script:not([data-swup-ignore-script])`)
            .join(", ")
        swup.hooks.on("content:replace", () => {
            document.querySelectorAll(CONTAINER_SELECTOR).forEach((old) => {
                const fresh = document.createElement("script")
                for (const { name, value } of old.attributes) fresh.setAttribute(name, value)
                fresh.textContent = old.textContent
                old.replaceWith(fresh)
            })
        })

        // 切页进度条：WAAPI 驱动，数值照搬参考站的 startProgressBar / finishProgressBar
        const progressBar = () => document.getElementById("progress-bar")
        const startProgressBar = () => {
            const el = progressBar()
            if (!el) return
            el.getAnimations().forEach(a => a.cancel())
            el.animate([{ transform: "scaleX(0)", opacity: 1 }, { transform: "scaleX(0.95)", opacity: 1 }], {
                duration: 8000,
                easing: "cubic-bezier(0.1, 0.05, 0.1, 1)",
                fill: "forwards",
            })
        }
        const finishProgressBar = () => {
            const el = progressBar()
            if (!el) return
            el.getAnimations().forEach(a => a.cancel())
            el.animate([{ transform: "scaleX(1)", opacity: 1 }, { transform: "scaleX(1)", opacity: 0 }], {
                duration: 500,
                easing: "ease-out",
                fill: "forwards",
            })
        }

        // 点当前页自身的链接（如已选中某个分类再点一次）：不走 Swup、不瞬跳，平滑滚回顶部
        document.addEventListener(
            "click",
            e => {
                const a = (e.target as Element).closest?.("a[href]") as HTMLAnchorElement | null
                if (!a) return
                if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
                if (a.target && a.target !== "_self") return
                const url = new URL(a.getAttribute("href") || "", location.href)
                if (url.origin !== location.origin || url.hash) return
                if (url.pathname + url.search !== location.pathname + location.search) return
                e.preventDefault()
                e.stopPropagation()
                window.scrollTo({ top: 0, behavior: "smooth" })
            },
            { capture: true }
        )

        swup.hooks.on("link:click", () => {
            document.documentElement.style.setProperty("--content-delay", "0ms")
            document.documentElement.classList.add("is-page-transitioning")
            // 导航栏若因向下滚动而收起，点击后立刻放回，别让它带着隐藏态进入新页
            const nav = document.getElementById("nav")
            if (nav) nav.style.transform = ""
        })

        // 分页页之间跳转（/ → /2/ → /3/）：落到**列表顶部**，不是文档顶部。
        // 本站横幅 65vh，回 0 等于让访客每翻一页都重看一遍横幅才够得着列表
        // （2026-11-06 用户报「点分页突然跳到顶部，你觉得该这样设计吗」= 不该）。
        //
        // 🔴 必须同时做两件事，只做一件都无效：
        //   ① `visit.scroll.reset = false` —— Swup 4 的 renderPage 末尾会执行内置
        //      `scrollToContent()`，默认 `window.scrollTo({top:0})`，会把这里任何提前滚动覆盖掉
        //      （第一版只改了 visit:start，实测落点仍是 0，就是它干的；源码见
        //       node_modules/swup/dist/Swup.module.js 里的 `D` / `scroll:top`）。
        //   ② 真正定位放在 `content:scroll` 钩子里 —— 那时新内容已经进 DOM，能拿新页几何。
        const pathOf = (u: string) => {
            const p = new URL(u, window.location.href).pathname.replace(/\/+$/, "")
            return p || "/"
        }
        const isListPage = (p: string) => p === "/" || /^\/\d+$/.test(p)
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
        const listNav = { pending: false }

        /** 列表顶部 = 内容面板上沿 − 导航条高 − 8px。
            三个分页页的横幅高度相同，所以这条在替换前后算出来是同一个值。 */
        const contentTopTarget = () => {
            const panel = document.querySelector(".content-panel")
            if (!panel) return -1
            const nav = document.getElementById("nav")
            const navH = nav ? nav.getBoundingClientRect().height : 72
            return Math.max(0, Math.round(window.scrollY + panel.getBoundingClientRect().top - navH - 8))
        }

        // 自定义平滑滚动：原生 behavior:"smooth" 的时长由浏览器定（2000px 会拖到 700ms+），
        // 这里用 rAF + easeInOutCubic 自己控时长，快而不生硬（用户 2026-11-06 要求「加上平滑滚动」）。
        // ⚠️ 动画期间每帧写 behavior:"instant"：写 smooth 会叠加浏览器的滚动动画，变成拖影。
        let scrollRaf = 0
        let scrollAnimating = false
        const smoothScrollTo = (top: number) => {
            cancelAnimationFrame(scrollRaf)
            const target = Math.max(0, Math.round(top))
            const startY = window.scrollY
            const delta = target - startY
            if (reducedMotion.matches || Math.abs(delta) < 24) {
                scrollAnimating = false
                window.scrollTo({ top: target, behavior: "instant" })
                return
            }
            const dur = Math.min(520, 240 + Math.abs(delta) * 0.13)
            const t0 = performance.now()
            const ease = (p: number) => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2)
            scrollAnimating = true
            const step = (now: number) => {
                const p = Math.min(1, (now - t0) / dur)
                window.scrollTo({ top: Math.round(startY + delta * ease(p)), behavior: "instant" })
                if (p < 1) scrollRaf = requestAnimationFrame(step)
                else {
                    scrollAnimating = false
                    window.scrollTo({ top: target, behavior: "instant" })
                }
            }
            scrollRaf = requestAnimationFrame(step)
        }

        // ── 切页骨架屏（用户 2026-11-06 报「列表空白时间长、没有炫酷的加载态」）
        // .transition-main 会整体淡出（120ms），而新 HTML 要等网络往返（线上 600~900ms）→ 列表区全空。
        // 骨架挂在 #center-content（不是 #swup-container）才不会被一起淡出；
        // CSS 里它是 fixed + 背景色 → 平滑滚动在它背后进行，视口里始终是完整加载态。
        // 只在「出发页或目标页是列表页」时显示：骨架是列表形状，套在文章页上会误导。
        const setLoading = (on: boolean) => {
            if (on) {
                const sk = document.getElementById("page-skeleton")
                const col = document.getElementById("center-content")
                const nav = document.getElementById("nav")
                if (sk && col) {
                    const r = col.getBoundingClientRect()
                    // 用 nav 的 **offsetHeight**（不受 transform 影响）而不是 getBoundingClientRect：
                    // 滚动到底点分页时，导航条此刻可能还带着 translateY(-100%) 的收起位移，
                    // rect.bottom ≤ 0 → 量出来是 0，骨架会顶到视口最上沿、被 fixed 导航条盖住标题行
                    // （实测第一版就是这样，.ps-head「载入中」整行看不见）。
                    // link:click 里已经会把 nav 的 transform 清空，所以用它的布局高度是稳的。
                    const navH = nav ? nav.offsetHeight : 72
                    sk.style.setProperty("--sk-left", `${Math.round(r.left)}px`)
                    sk.style.setProperty("--sk-width", `${Math.round(r.width)}px`)
                    sk.style.setProperty("--sk-top", `${Math.round(navH) + 8}px`)
                }
            }
            document.documentElement.classList.toggle("is-loading", on)
        }

        swup.hooks.on("content:scroll", () => {
            if (!listNav.pending) return
            listNav.pending = false
            const target = contentTopTarget()
            // 平滑滚动可能还在飞（点击那一刻就起滚了）；还在动就别打断，否则会顿一下
            if (target >= 0 && !scrollAnimating && Math.abs(window.scrollY - target) > 2) smoothScrollTo(target)
        })

        // 回顶放在 visit:start（与点击同一个任务、下一帧绘制之前），浏览器永远不会画出
        // "旧页滚到一半"的样子。之前把回顶留在淡出窗口里，横幅静止不动时就会看到整屏跳一下
        swup.hooks.on("visit:start", visit => {
            startProgressBar()

            const fromPath = pathOf(window.location.href)
            const toPath = pathOf(visit.to.url)
            if (isListPage(fromPath) || isListPage(toPath)) setLoading(true)

            if (isListPage(fromPath) && isListPage(toPath)) {
                visit.scroll.reset = false
                listNav.pending = true
                const target = contentTopTarget()
                if (target >= 0) smoothScrollTo(target)
            } else if (window.innerWidth >= 768) {
                window.scrollTo({ top: 0, behavior: "instant" })
            }

            // 首页↔非首页：横幅高度在两套变量间切换，过渡类只在切页期间挂上（照搬参考站）
            const targetPath = new URL(visit.to.url, window.location.href).pathname
            const targetIsHome = targetPath === "/" || /^\/\d+\/$/.test(targetPath)
            if (document.body.classList.contains("is-home") !== targetIsHome) {
                document.documentElement.classList.add("is-wallpaper-transitioning")
                document.body.classList.toggle("is-home", targetIsHome)
            }
        })

        // 新内容一进 DOM 就撤骨架；失败/中断也要撤，否则会一直盖着（漏了这条就是"永远加载中"）
        swup.hooks.on("page:view", () => setLoading(false))
        swup.hooks.on("visit:fail", () => setLoading(false))
        swup.hooks.on("visit:abort", () => setLoading(false))

        swup.hooks.on("visit:end", () => {
            finishProgressBar()
            window.setTimeout(() => document.documentElement.classList.remove("is-page-transitioning"), 200)
            // 高度过渡 450ms，等它跑完再摘类，否则 transition 属性被撤掉会瞬间跳变
            window.setTimeout(() => document.documentElement.classList.remove("is-wallpaper-transitioning"), 500)
        })

        // 桥接：仓库里 12 个组件监听 Swup 3 旧名与 Astro VT 事件名，Swup 4 均不派发，见
        // docs/superpowers/specs/2026-09-23-page-transitions-design.md 的影响域分析
        const fire = (name: string) => document.dispatchEvent(new CustomEvent(name))
        swup.hooks.on("content:replace", () => fire("swup:contentReplaced"))
        swup.hooks.on("page:view", () => {
            fire("astro:page-load")
            fire("astro:after-swap")
        })
    }

    if (effectsConfig.windowResize && !reduced) {
        // 拖拽期间冻结布局宽度，松手后用 View Transitions 一次性 morph 到新布局。
        // 断点跨越改的是 grid 轨道数量与 sidebar 的 display，CSS transition 插值不了，
        // 只有"冻结 → 快照 → 应用新布局"才能让它有动画（Firefly 本体也没做这块）
        const root = document.documentElement
        let frozen = false
        let timer = 0
        // 只认宽度变化：morph 只为跨断点（grid 轨道数 / sidebar display 改变）而存在。
        // 手机地址栏收起/展开只改高度却会触发 resize，若照旧 freeze+startViewTransition，
        // 滚动中会反复整页快照交叉淡化 → 重影、旧快照与新页面叠印（2026-09-24 手机实测）
        let lastWidth = window.innerWidth
        const shell = () => document.getElementById("page-shell")
        const freeze = () => {
            const el = shell()
            // 零尺寸视口（隐藏标签页等）下取到的宽度是 0，冻结会把布局塌缩，跳过
            if (!el || frozen) return
            const w = getComputedStyle(el).width
            if (!w || w === "0px") return
            el.style.width = w
            frozen = true
        }
        const unfreeze = () => {
            const el = shell()
            if (el) el.style.width = ""
            frozen = false
        }
        window.addEventListener(
            "resize",
            () => {
                const w = window.innerWidth
                if (w === lastWidth) return
                lastWidth = w
                // Swup visit 飞行中不干预，避免与页面过渡打架
                if (root.classList.contains("is-changing")) return
                if (!frozen) freeze()
                root.setAttribute("data-resizing", "")
                clearTimeout(timer)
                timer = window.setTimeout(() => {
                    if (typeof document.startViewTransition === "function") {
                        const vt = document.startViewTransition(() => unfreeze())
                        vt.finished.finally(() => root.removeAttribute("data-resizing"))
                    } else {
                        unfreeze()
                        root.removeAttribute("data-resizing")
                    }
                }, 180)
            },
            { passive: true },
        )
    }
</script>
