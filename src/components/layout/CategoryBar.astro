---
import { getCategoryList, getSortedPostsList } from "@/utils/content-utils"
import { Icon } from "astro-icon/components"
import { url } from "@/utils/url-utils"

const categories = await getCategoryList()
const totalPosts = (await getSortedPostsList()).length
const homeUrl = url("/")
const archiveUrl = url("/archive/")
const categoriesUrl = url("/categories/")
---

<div id="category-bar" data-home-path={homeUrl} data-archive-path={archiveUrl} class="card-base category-bar p-3">
	<div class="flex items-center gap-2">
		<!-- ③ 滑动指示器（2026-11-05 第三十一批）：一个绝对定位的主色块，
		     由 JS 按当前激活 pill 的 offsetLeft/Width 定位；切分类时它滑过去而不是瞬跳。
		     ⚠️ 它必须在 pill 之前、z-index 更低，否则会盖住文字。
		     ⚠️ 只覆盖「首页 / 归档 / 分类」这三类，不含"更多"（那是跳转页不是筛选）。 -->
		<div class="category-indicator" aria-hidden="true"></div>
		<a
			href={homeUrl}
			class="category-link-home flex h-7 shrink-0 items-center justify-center px-2 py-1 text-sm transition-colors duration-150 ease-out"
			aria-label="首页"
			data-category-name="__home__"
		>
			<Icon name="material-symbols:home" class="text-lg" />
		</a>
		<a
			href={archiveUrl}
			class="category-pill flex h-7 shrink-0 items-center justify-center px-3 py-1 text-sm whitespace-nowrap transition-colors duration-150 ease-out"
			data-category-name="__archive__"
		>
			归档
			<span class="ml-1 text-xs opacity-60">{totalPosts}</span>
		</a>
		<div class="category-divider shrink-0"></div>
		<div class="relative min-w-0 flex-1">
			<div class="scroll-fade scroll-fade-left" aria-hidden="true"></div>
			<div class="category-scroll flex gap-2 overflow-x-auto">
				{
					categories.map(cat => (
						<a
							href={cat.url}
							class="category-pill flex h-7 items-center justify-center px-3 py-1 text-sm whitespace-nowrap transition-colors duration-150 ease-out"
							data-category-name={cat.name}
						>
							{cat.name}
							<span class="ml-1 text-xs opacity-60">{cat.count}</span>
						</a>
					))
				}
			</div>
			<div class="scroll-fade scroll-fade-right" aria-hidden="true"></div>
		</div>
		<div class="category-divider more-divider shrink-0" aria-hidden="true"></div>
		<a
			href={categoriesUrl}
			class="category-pill flex h-7 shrink-0 items-center justify-center gap-1 px-3 py-1 text-sm whitespace-nowrap transition-colors duration-150 ease-out"
			data-category-name="__categories__"
			aria-label="更多"
		>
			<span>更多</span>
			<Icon name="fa7-solid:chevron-right" class="text-xs" />
		</a>
	</div>
</div>

<style>
	.category-bar {
		/* 和slot内容间隔 */
		margin-bottom: 1rem;
		/* ③ 滑动指示器相对它定位（这里不能再加 padding，指示器的坐标按 padding-box 算） */
		position: relative;
	}

	/* ── ③ 分类栏滑动指示器（2026-11-05 第三十一批）──────────────────────────
	   原先是「激活的 pill 自己变成主色底」——切分类时是新旧两个色块同时闪一下，
	   看着像抖。现在换成一块在主色渐变背景下滑动的色块，pill 文字颜色跟着转。

	   🔴 三个必须记住的点：
	   ① 指示器**放在横向滚动容器外**（.category-bar 的直接子元素），因为激活的 pill
	      可能滚出可视区，指示器如果跟着滚就会被裁掉 → 它只画"看得见时才亮"。
	      实现上由 updateIndicator() 判断可视性决定 opacity。
	   ② 坐标必须用 **offsetLeft/offsetWidth**（相对 offsetParent），不要 getBoundingClientRect：
	      后者含滚动位移，会因为 .category-scroll 的 scrollLeft 而漂。
	   ③ .btn-plain 会盖显隐（AGENTS 五-20），指示器不带那个类，所以没问题。
	   多色渐变：主色 → 偏移色相 → 主色，跟 --hue 一起转。 */
	.category-indicator {
		position: absolute;
		/* 🔴 left:0 必须显式写：不写的话它是 left:auto，静态位置已经落在 padding box 内
		   （12px padding + 1px border），再叠 translateX 就整体右移 13px
		   （实测 width 对得上、left 恒偏 13）。 */
		left: 0;
		top: 0.75rem; /* = .category-bar 的 p-3 */
		height: 1.75rem; /* = pill 的 h-7 */
		border-radius: 0.25rem;
		opacity: 0;
		pointer-events: none;
		z-index: 0;
		transition:
			transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
			width 0.32s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.2s ease;
		background: linear-gradient(
			100deg,
			oklch(0.62 0.14 calc(var(--hue) + 0)),
			oklch(0.66 0.15 calc(var(--hue) + 55)) 55%,
			oklch(0.60 0.16 calc(var(--hue) + 110))
		);
		box-shadow: 0 4px 14px -6px color-mix(in oklch, var(--primary) 65%, transparent);
	}
	.category-indicator[data-visible] {
		opacity: 1;
	}

	/* 有指示器时，pill 自己的主色底要撤掉（否则两层主色叠着过曝） */
	.category-bar[data-has-indicator] .category-pill[data-active],
	.category-bar[data-has-indicator] .category-link-home[data-active] {
		background: transparent;
		border-color: transparent;
		color: #fff;
	}
	.category-bar[data-has-indicator] .category-pill[data-active]:hover,
	.category-bar[data-has-indicator] .category-link-home[data-active]:hover {
		background: transparent;
		border-color: transparent;
		color: #fff;
		opacity: 1;
	}

	/* pill 要压在指示器上面，否则文字被盖住 */
	.category-bar .category-pill,
	.category-bar .category-link-home,
	.category-bar .category-divider,
	.category-bar .more-divider {
		position: relative;
		z-index: 1;
	}

	.category-divider {
		width: 1px;
		align-self: stretch;
		background-color: var(--line-divider);
	}
	/* 更多前的分隔线：只在横向溢出时出现（参考站 more-divider 的 data-visible 逻辑） */
	.more-divider {
		opacity: 0;
		transition: opacity 300ms ease-in-out;
	}
	.more-divider[data-visible] {
		opacity: 1;
	}
	.scroll-fade {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 2.5rem;
		pointer-events: none;
		opacity: 0;
		transition: opacity 300ms ease-in-out;
		z-index: 1;
	}
	/* 通过JS控制添加移除data-visible */
	.scroll-fade[data-visible] {
		opacity: 1;
	}
	.scroll-fade-left {
		left: 0;
		background: linear-gradient(to left, transparent, var(--card-bg));
	}
	.scroll-fade-right {
		right: 0;
		background: linear-gradient(to right, transparent, var(--card-bg));
	}
	/* 去掉滚动条展示，但是具有滚动条 */
	.category-scroll {
		scrollbar-width: none;
		-ms-overflow-style: none;
		scroll-behavior: smooth;
	}
	.category-scroll::-webkit-scrollbar {
		display: none;
	}
	/* 分类按钮Home */
	.category-link-home {
		transition: all 0.3s;
		background: transparent;
		color: var(--btn-content);
		border: 1.5px solid var(--line-divider);
	}
	.category-link-home[data-active] {
		background: var(--primary);
		color: #fff;
		border-color: var(--primary);
	}
	.category-link-home:hover {
		border-color: var(--primary);
		color: var(--primary);
		background: transparent;
	}
	.category-link-home[data-active]:hover {
		background: var(--primary);
		border-color: var(--primary);
		color: #fff;
		opacity: 0.8;
	}
	/* 其他标签 */
	.category-pill {
		border: 1.5px solid var(--line-divider);
		color: var(--btn-content);
		background: transparent;
	}
	.category-pill:hover {
		border-color: var(--primary);
		color: var(--primary);
		background: transparent;
	}
	.category-pill[data-active] {
		background: var(--primary);
		border-color: var(--primary);
		color: white;
	}
	.category-pill[data-active]:hover {
		background: var(--primary);
		border-color: var(--primary);
		opacity: 0.9;
	}
	/* 文章页：文章所属分类的软高亮，数值照搬参考站 */
	.category-pill[data-soft-active] {
		background: color-mix(in srgb, var(--primary) 18%, transparent);
		color: color-mix(in srgb, var(--primary) 90%, var(--btn-content));
		font-weight: 600;
	}
	.category-pill[data-soft-active]:hover {
		background: color-mix(in srgb, var(--primary) 25%, transparent);
		color: var(--primary);
	}
</style>

<script>
	// tags、categories处理
	function getCategoryBarState(bar: HTMLElement, currentUrl: URL) {
		const pathname = currentUrl.pathname.replace(/\/$/, "")
		const homePath = (bar.getAttribute("data-home-path") || "/").replace(/\/$/, "")
		const archivePath = (bar.getAttribute("data-archive-path") || "/archive").replace(/\/$/, "")
		const isHome = pathname === homePath || pathname === "" || pathname === "/"
		const isArchive = pathname === archivePath
		const isCategories = pathname === "/categories"
		const escapedHomePath = homePath.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
		// 分页页面（如 /2/, /3/）也属于首页的延续
		const isHomePagination =
			/^\/\d+$/.test(pathname) || (homePath !== "" && new RegExp(`^${escapedHomePath}\\/\\d+$`).test(pathname))

		return {
			isHome,
			isArchive,
			isCategories,
			isHomePagination,
			activeCategory: currentUrl.searchParams.get("category") || "",
			hasTag: currentUrl.searchParams.has("tag"),
			hasUncategorized: currentUrl.searchParams.has("uncategorized"),
		}
	}

	function setActiveCategory(bar: HTMLElement, currentUrl: URL) {
		const { isHome, isArchive, isCategories, isHomePagination, activeCategory, hasTag, hasUncategorized } =
			getCategoryBarState(bar, currentUrl)
		const postCategory = (bar.getAttribute("data-current-post-category") || "").trim()

		// 移除所有按钮的 active 状态
		const homeButton = bar.querySelector<HTMLAnchorElement>('.category-link-home[data-category-name="__home__"]')
		const pills = bar.querySelectorAll<HTMLAnchorElement>(".category-pill")

		homeButton?.removeAttribute("data-active")
		pills.forEach(pill => {
			pill.removeAttribute("data-active")
			pill.removeAttribute("data-soft-active")
		})

		if (isHome || isHomePagination) {
			// 首页时激活首页按钮
			homeButton?.setAttribute("data-active", "")
			return
		}

		if (isCategories) {
			// 分类总览页激活"更多"按钮（照搬参考站 h() 的判断顺序）
			bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__categories__"]')?.setAttribute(
				"data-active",
				"",
			)
			return
		}

		if (activeCategory) {
			pills.forEach(pill => {
				if (pill.getAttribute("data-category-name") === activeCategory) {
					pill.setAttribute("data-active", "")
				}
			})
			return
		}

		if (isArchive && !hasTag && !hasUncategorized) {
			bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__archive__"]')?.setAttribute(
				"data-active",
				"",
			)
			return
		}

		// 文章页不隐藏分类栏，只给文章所属分类打软高亮（照搬参考站的 data-soft-active）
		if (postCategory) {
			pills.forEach(pill => {
				if (pill.getAttribute("data-category-name") === postCategory) {
					pill.setAttribute("data-soft-active", "")
				}
			})
		}
	}

	function scrollActiveCategoryIntoView(bar: HTMLElement, behavior: ScrollBehavior = "smooth") {
		const activePill = bar.querySelector<HTMLAnchorElement>(".category-pill[data-active]")
		const scroll = bar.querySelector<HTMLElement>(".category-scroll")
		if (!activePill || !scroll) return

		const scrollLeft = activePill.offsetLeft - scroll.offsetLeft - (scroll.clientWidth - activePill.offsetWidth) / 2
		scroll.scrollTo({ left: Math.max(0, scrollLeft), behavior })
	}

	/**
	 * ③ 滑动指示器：把 .category-indicator 摆到当前激活的 pill 上。
	 *
	 * 🔴 坐标用 offsetLeft / offsetWidth，**不要用 getBoundingClientRect**：
	 *    pill 在 .category-scroll 里，rect 含 scrollLeft 位移，横滚一下指示器就漂了。
	 * 🔴 激活的 pill 可能滚出可视区（分类多时）→ 那时整块指示器淡出，
	 *    否则它会贴在容器边缘冒充一个"激活项"。
	 * ⚠️ 指示器是 .category-bar 的直接子元素，而 pill 的 offsetParent 是 .category-scroll
	 *    （它带 overflow，成为 offsetParent）→ 要把 scroll 的 offsetLeft 与 scrollLeft 都补上。
	 */
	function updateIndicator(bar: HTMLElement) {
		const indicator = bar.querySelector<HTMLElement>(".category-indicator")
		const scroll = bar.querySelector<HTMLElement>(".category-scroll")
		if (!indicator) return

		const active =
			bar.querySelector<HTMLAnchorElement>(".category-pill[data-active]") ||
			bar.querySelector<HTMLAnchorElement>(".category-link-home[data-active]")

		// 软高亮（文章页）不算激活：那种情况下面板不该有滑块
		if (!active) {
			indicator.removeAttribute("data-visible")
			bar.removeAttribute("data-has-indicator")
			return
		}

		bar.setAttribute("data-has-indicator", "")

		// 基础坐标：bar 的 padding（p-3 = 12px）+ pill 在滚动容器里的位置 - 滚动位移
		const barRect = bar.getBoundingClientRect()
		const activeRect = active.getBoundingClientRect()
		const x = activeRect.left - barRect.left
		const w = activeRect.width

		// 可视性：pill 完全落在滚动容器可视区内才算
		let visible = true
		if (scroll && scroll.contains(active)) {
			const sr = scroll.getBoundingClientRect()
			visible = activeRect.left >= sr.left - 1 && activeRect.right <= sr.right + 1
		}

		indicator.style.width = w + "px"
		indicator.style.transform = `translateX(${x}px)`
		if (visible) indicator.setAttribute("data-visible", "")
		else indicator.removeAttribute("data-visible")
	}

	function updateCategoryBar(currentUrl = new URL(window.location.href)) {
		const bar = document.getElementById("category-bar")
		if (!bar) return

		// 分类栏在 Swup 容器外、不会随页替换，文章分类要从新容器上同步过来（参考站同款做法）
		const container = document.getElementById("swup-container")
		if (container) {
			bar.setAttribute("data-current-post-category", container.getAttribute("data-current-post-category") || "")
		}

		setActiveCategory(bar, currentUrl)
		scrollActiveCategoryIntoView(bar)
		// ③ 指示器要在高亮算完之后摆，且滚动容器可能刚被 scrollTo 挪过 → 下一帧再量
		requestAnimationFrame(() => updateIndicator(bar))
	}

	function initCategoryBarInteractions() {
		const bar = document.getElementById("category-bar")
		if (!bar || bar.dataset.clickBound === "true") return

		bar.dataset.clickBound = "true"
		bar.addEventListener("click", event => {
			if (!(event.target instanceof Element)) return

			const pill = event.target.closest<HTMLAnchorElement>(".category-pill")
			if (!pill) return

			if (
				event.defaultPrevented ||
				event.button !== 0 ||
				event.metaKey ||
				event.ctrlKey ||
				event.shiftKey ||
				event.altKey
			) {
				return
			}

			if (pill.target && pill.target !== "_self") return

			const targetUrl = new URL(pill.href, window.location.href)
			if (targetUrl.origin !== window.location.origin) return

			setActiveCategory(bar, targetUrl)
			scrollActiveCategoryIntoView(bar, "auto")
		})
	}
	// 初始化滚动特性-横线滚动/左右背景透明渐变
	function initScrollFeatures() {
		const bar = document.getElementById("category-bar")
		if (!bar) return false
		const scroll = bar.querySelector<HTMLElement>(".category-scroll")
		if (!scroll) return false
		// 鼠标横线滚动
		scroll.addEventListener(
			"wheel",
			e => {
				if (scroll.scrollWidth <= scroll.clientWidth) return // 如果比元素口小，则不用横线滚动
				e.preventDefault()
				scroll.scrollLeft += e.deltaY
			},
			{ passive: false },
		)
		// 滚动时更新左右的透明渐变
		scroll.addEventListener("scroll", updateScrollHint)
		window.addEventListener("resize", updateScrollHint)
		updateScrollHint()
	}
	function updateScrollHint() {
		const bar = document.getElementById("category-bar")
		if (!bar) return
		const scroll = bar.querySelector<HTMLElement>(".category-scroll")
		const fadeLeft = bar.querySelector<HTMLElement>(".scroll-fade-left")
		const fadeRight = bar.querySelector<HTMLElement>(".scroll-fade-right")
		const moreDivider = bar.querySelector<HTMLElement>(".more-divider")
		if (!scroll || !fadeLeft || !fadeRight) return

		// 判断是否有横向滚动需求
		const hasOverflow = scroll.scrollWidth > scroll.clientWidth + 1
		// 判断滚动条是否在最左侧/最右侧
		const isStart = scroll.scrollLeft <= 1
		const isEnd = scroll.scrollLeft + scroll.clientWidth >= scroll.scrollWidth - 1

		// 溢出时才显示"更多"前的分隔线（参考站 l() 同款）
		if (moreDivider) {
			if (hasOverflow) {
				moreDivider.setAttribute("data-visible", "")
			} else {
				moreDivider.removeAttribute("data-visible")
			}
		}

		if (hasOverflow && !isStart) {
			fadeLeft.setAttribute("data-visible", "")
		} else {
			fadeLeft.removeAttribute("data-visible")
		}

		if (hasOverflow && !isEnd) {
			fadeRight.setAttribute("data-visible", "")
		} else {
			fadeRight.removeAttribute("data-visible")
		}

		// ③ 横滚之后 pill 的屏幕位置变了 → 指示器要重摆（否则会漂在旧位置）
		updateIndicator(bar)
	}
	window.onReinit("category-bar", updateCategoryBar)
	initCategoryBarInteractions()
	// 分类栏在 Swup 容器外、元素永不被替换，所以滚动相关的监听整个文档只该绑一次。
	// 原来这里跟 updateCategoryBar 一起挂在 astro:page-load 上，每换一次页就多一组
	// wheel/scroll/resize 监听 → 鼠标横滚的位移按访问页数叠加（2026-10-01 查出）
	window.reinitOnce("category-bar-scroll", initScrollFeatures)
	// 窗口尺寸变化 → pill 的 px 位置全变，指示器必须重摆（这里只绑一次）
	window.reinitOnce("category-bar-indicator-resize", () => {
		window.addEventListener(
			"resize",
			() => {
				const bar = document.getElementById("category-bar")
				if (bar) updateIndicator(bar)
			},
			{ passive: true },
		)
		return true
	})
	// 在 Swup 导航时同步分类栏的高亮（参考站：visit:start 只刷高亮，不做显隐）
	function setupSwupEarlyUpdate() {
		if (!window.swup?.hooks) return
		window.swup.hooks.on("visit:start", (visit: any) => {
			const bar = document.getElementById("category-bar")
			if (!bar) return
			setActiveCategory(bar, new URL(visit.to.url, window.location.href))
		})
	}
	if (window.swup?.hooks) {
		setupSwupEarlyUpdate()
	} else {
		document.addEventListener("swup:enable", setupSwupEarlyUpdate)
	}
</script>
