---
import { Icon } from "astro-icon/components"
import Layout from "@/layouts/Layout.astro"
import { getSeriesList } from "@/utils/content-utils"
import { getPostUrlBySlug } from "@/utils/url-utils"

const seriesList = await getSeriesList()
const totalPosts = seriesList.reduce((sum, s) => sum + s.count, 0)
---

<Layout title="系列-亦林">
	<div class="card-base px-8 py-6 mb-4">
		<div class="text-2xl font-bold text-(--primary) mb-2">系列</div>
		<p class="text-30 text-sm">全部系列 · {totalPosts} 篇文章</p>
	</div>

	{
		seriesList.length > 0 ? (
			<div class="grid grid-cols-[repeat(auto-fit,minmax(20rem,1fr))] items-start gap-4 mb-4">
				{seriesList.map((series) => (
					<div class="series-acc card-base overflow-hidden">
						<button
							type="button"
							aria-expanded="false"
							class="series-acc-header group flex w-full items-center gap-3 p-5 md:p-6 pb-3 cursor-pointer select-none text-left transition"
						>
							<span class="shrink-0 w-12 h-12 rounded-full bg-(--primary)/10 group-hover:bg-(--primary)/20 flex items-center justify-center transition-colors">
								<Icon name="material-symbols:layers" aria-hidden="true" class="text-2xl text-(--primary)" />
							</span>
							<span class="flex-1 min-w-0">
								<span class="block text-lg font-bold text-90 truncate group-hover:text-(--primary) transition">
									{series.name}
								</span>
								<span class="block text-sm text-30 mt-0.5 transition group-hover:text-(--primary)/60">
									{series.count} 篇文章
								</span>
							</span>
							<Icon
								name="material-symbols:keyboard-arrow-down-rounded"
								aria-hidden="true"
								class="acc-arrow shrink-0 text-[1.25rem] text-30 group-hover:text-(--primary) transition-transform duration-300"
							/>
						</button>

						<div class="series-acc-content overflow-hidden max-h-0 transition-[max-height,opacity] duration-300 ease-in-out">
							<ol class="flex flex-col px-5 md:px-6 pb-4">
								{series.posts.map((post, idx) => (
									<li>
										<a
											href={getPostUrlBySlug(post.id)}
											class:list={[
												"group flex items-center gap-3 px-3 py-3 -mx-1 rounded-lg transition-all",
												"hover:bg-black/5 dark:hover:bg-white/5 active:scale-[0.98]",
												idx < series.posts.length - 1 && "border-b border-dashed border-(--line-divider)",
											]}
										>
											<span class="shrink-0 w-6 h-6 rounded-md bg-(--btn-regular-bg) text-(--primary) flex items-center justify-center text-sm font-bold transition">
												{idx + 1}
											</span>
											<span class="flex-1 min-w-0 font-bold text-sm text-black/75 dark:text-white/75 truncate transition group-hover:text-(--primary)">
												{post.data.title}
											</span>
											<Icon
												name="material-symbols:chevron-right-rounded"
												aria-hidden="true"
												class="shrink-0 text-xl text-black/15 dark:text-white/15 transition group-hover:text-(--primary) group-hover:translate-x-0.5"
											/>
										</a>
									</li>
								))}
							</ol>
						</div>
					</div>
				))}
			</div>
		) : (
			<div class="card-base px-8 py-12 text-center">
				<Icon name="material-symbols:layers" class="text-5xl text-30 mx-auto mb-4" />
				<p class="text-30">还没有文章归入任何系列</p>
			</div>
		)
	}

	<script is:inline>
		/* C6（2026-11-15 第五十七批）：支持 interpolate-size 时走 height:auto 过渡，
		   不再量 scrollHeight 塞魔法数字。⚠️ 两条分支由同一个 C6 常量判定，绝不混用。
		   不支持的浏览器整段退回原来的 max-height + JS 量高，功能完全一致（渐进增强）。 */
		var C6 = typeof CSS !== "undefined" && CSS.supports && CSS.supports("interpolate-size", "allow-keywords");

		function markAccordion() {
			if (!C6) return;
			var nodes = document.querySelectorAll(".series-acc-content");
			for (var i = 0; i < nodes.length; i++) {
				nodes[i].setAttribute("data-c6", "height");
				nodes[i].setAttribute("data-open", "false");
			}
		}

		function setOpen(content, open) {
			content.setAttribute("data-open", String(open));
			if (C6) return; // height:auto 由 CSS 插值，JS 不碰内联高度
			content.style.maxHeight = open ? content.scrollHeight + "px" : "0px";
		}

		function onSeriesAccordion(e) {
			var btn = e.target && e.target.closest ? e.target.closest(".series-acc-header") : null;
			if (!btn) return;
			var card = btn.closest(".series-acc");
			var content = card ? card.querySelector(".series-acc-content") : null;
			if (!content) return;

			var isOpen = btn.getAttribute("aria-expanded") === "true";

			// 手风琴：先收起其它已展开的系列
			var others = document.querySelectorAll('.series-acc-header[aria-expanded="true"]');
			for (var i = 0; i < others.length; i++) {
				var o = others[i];
				if (o === btn) continue;
				o.setAttribute("aria-expanded", "false");
				var oc = o.closest(".series-acc");
				var ocC = oc ? oc.querySelector(".series-acc-content") : null;
				if (ocC) setOpen(ocC, false);
			}

			var next = !isOpen;
			btn.setAttribute("aria-expanded", String(next));
			setOpen(content, next);
		}

		/* 🔴 本脚本在 Swup 容器内、正文之后：DOMContentLoaded 兜首屏 markAccordion，
		   软导航进 /series/ 时由 onReinit 重新标记新插入的容器（fn 里重新查 DOM，不抓旧节点）。
		   reinitOnce 保证 document 点击委托整份文档只挂一次（十-14 / 十-11）。 */
		function markWhenReady() { markAccordion(); }
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", markWhenReady, { once: true });
		} else {
			markWhenReady();
		}
		window.onReinit("series-accordion-mark", markAccordion, { immediate: false });

		window.reinitOnce("series-accordion", function () {
			document.addEventListener("click", onSeriesAccordion);
			return true;
		});
	</script>
</Layout>
