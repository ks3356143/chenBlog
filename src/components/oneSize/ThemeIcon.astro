---
// 主题切换按钮。2026-11-05 第三十一批：点击改成**圆形扩散揭幕**（View Transitions API）。
//
// 做法（零依赖、纯原生）：点按钮 → document.startViewTransition(() => 切 data-theme)
//   → 新旧两帧各是一张快照，用 clip-path: circle() 让新帧从按钮中心扩散开。
//   不支持的浏览器（旧 Safari / 旧 Firefox）走原有逻辑，**瞬间切换、不报错**。
//
// 🔴 四个必须记住的点：
//   ① **必须给 ::view-transition-new(root) 加 clip-path 动画**，否则默认是交叉淡化，
//      看起来不是"扩散"而只是"渐变"。
//   ② `mix-blend-mode: normal` 必须显式写：Chrome 默认 root 过渡带 plus-lighter，
//      某些底色组合下会闪白。
//   ③ **reduced-motion 用户不要走 VT**：扩散对前庭敏感人群就是眩晕源。
//      这条必须在 JS 里判 —— CSS 媒体查询管不住 startViewTransition（一调用就会跑）。
//   ④ resize morph（SwupManager）也用 startViewTransition，但触发源不同
//      （窗口 resize vs 点击），实际不会撞车，共用 root 过渡参数安全。
---

<button id="themeToggle" type="button" class="btn-plain cursor-pointer p-2" aria-label="切换亮暗主题">
	<svg width="24px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
		<path
			class="sun"
			fill-rule="evenodd"
			d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"
		></path>
		<path
			class="moon"
			fill-rule="evenodd"
			d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"
		></path>
	</svg>
</button>

<style>
	#themeToggle {
		border: 0;
		background: none;
	}
	.sun {
		fill: currentColor;
	}
	.moon {
		fill: transparent;
	}
	:global([data-theme="dark"]) .sun {
		fill: transparent;
	}
	:global([data-theme="dark"]) .moon {
		fill: currentColor;
	}

	/* ── 圆形扩散揭幕 ─────────────────────────────────────────────────────
	   半径取到「按钮中心 → 视口最远角」，才保证整页被覆盖；数值由 JS 算好塞进 --vt-r。
	   timing 用 cubic-bezier(0.22,1,0.36,1)（ease-out-quint）而不是线性：
	   线性在收尾会明显拖沓，这条曲线前段快、后段稳稳停住。 */
	:global(::view-transition-old(root)),
	:global(::view-transition-new(root)) {
		animation-duration: 520ms;
		animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
		mix-blend-mode: normal;
	}
	:global(::view-transition-old(root)) {
		z-index: 2;
		animation: none;
	}
	:global(::view-transition-new(root)) {
		z-index: 3;
		animation: theme-reveal 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	@keyframes theme-reveal {
		from {
			clip-path: circle(0 at var(--vt-x, 50%) var(--vt-y, 50%));
		}
		to {
			clip-path: circle(var(--vt-r, 100vmax) at var(--vt-x, 50%) var(--vt-y, 50%));
		}
	}

	/* reduced-motion：JS 里根本不调用 VT，这条是双保险 */
	@media (prefers-reduced-motion: reduce) {
		:global(::view-transition-old(root)),
		:global(::view-transition-new(root)) {
			animation: none !important;
		}
	}
</style>

<script is:inline>
	const setToggleListener = () => {
		let toggleBtn = document.getElementById("themeToggle")

		const applyTheme = () => {
			const element = document.documentElement
			const isDark = element.dataset.theme === "dark"
			element.dataset.theme = isDark ? "light" : "dark"
			localStorage.setItem("theme", isDark ? "light" : "dark")
		}

		const handleToggleClick = () => {
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
			const canVT = typeof document.startViewTransition === "function"
			// 🔴 reduced-motion 或浏览器不支持 → 直接切（老行为），不碰 View Transition
			if (reduce || !canVT || !toggleBtn) {
				applyTheme()
				return
			}

			// 扩散圆心 = 按钮中心；半径 = 到视口四个角里最远的那个
			const r = toggleBtn.getBoundingClientRect()
			const cx = r.left + r.width / 2
			const cy = r.top + r.height / 2
			const far = Math.max(
				Math.hypot(cx, cy),
				Math.hypot(window.innerWidth - cx, cy),
				Math.hypot(cx, window.innerHeight - cy),
				Math.hypot(window.innerWidth - cx, window.innerHeight - cy),
			)
			const root = document.documentElement
			root.style.setProperty("--vt-x", cx + "px")
			root.style.setProperty("--vt-y", cy + "px")
			root.style.setProperty("--vt-r", Math.ceil(far) + "px")

			// ⚠️ 回调里必须**同步**改好 DOM：异步改动会被算进新帧之后，扩散就看不见了
			document.startViewTransition(applyTheme)
		}

		toggleBtn?.addEventListener("click", handleToggleClick)
	}

	setToggleListener()
	// 不在 astro:after-swap 里再绑一次：本按钮在 Header（Swup 容器外），节点永不被替换，
	// 重新 addEventListener 只会让一次点击翻转两次主题 = 看起来按了没反应
</script>
