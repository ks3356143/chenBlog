---
import ThemeIcon from "@/components/oneSize/ThemeIcon.astro"
import Search from "@/components/controls/Search.svelte"
import Menu from "@/assets/menu.svg"
import MobileMenu from "@/components/headers/MobileMenu.astro"
import DropdownMenu from "@/components/headers/DropdownMenu.astro"
import DisplaySettings from "@/components/features/DisplaySettings.astro"
import { navBarLinks } from "@/config/navBarConfig"
---

<nav id="nav" aria-label="主导航" class="backdrop nav-bg fixed top-0 h-18 w-full z-30">
	<div class="mx-auto flex h-18 items-center justify-between overflow-visible! px-4 xl:w-[92vw]">
		<div
			class="relative flex h-full w-full items-center justify-between lg:grid lg:grid-cols-[auto_minmax(0,1fr)_auto]"
		>
			<a href="/" class="btn-plain flex h-13 items-center gap-2 px-5" aria-label="亦林 首页">
				<!-- 双木成林：两棵高低错落的极简小树，描边跟 --primary 走，亮暗主题自动换色 -->
				<svg
					viewBox="0 0 32 32"
					class="h-7 w-7 shrink-0"
					fill="none"
					stroke="var(--primary)"
					stroke-width="2.6"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M10 26V8" />
					<path d="M10 15 5 10" />
					<path d="M10 15 15 10" />
					<path d="M22 26V12" />
					<path d="M22 19 17.5 14.5" />
					<path d="M22 19 26.5 14.5" />
					<path d="M5 26h22" />
				</svg>
				<span class="text-lg font-semibold tracking-wide">亦林</span>
			</a>
			<div class="col-start-2 hidden items-center justify-center space-x-1 lg:flex">
				{navBarLinks.map(link => <DropdownMenu link={link} />)}
			</div>

			<div class="flex items-center justify-center space-x-1">
				<Search client:load />
				<div class="flex items-center justify-center space-x-1">
					<ThemeIcon />
					<!-- 显示设置开关 + 面板。整组放在导航栏里（照参考站 #display-setting 的位置），
					     Header 在 Swup 容器外 → 面板开合状态跨软导航保持，不需要任何 reinit。 -->
					<DisplaySettings />
					<div id="nav-menu-panel" class="lg:hidden">
						<div class="btn-plain cursor-pointer p-2">
							<Menu />
						</div>
					</div>
				</div>
			</div>
			<MobileMenu />
		</div>
	</div>
</nav>

<style>
	.nav-bg {
		background-image: var(--nav-bg);
		box-shadow: 0.1rem 0.1rem 0.2rem var(--grey-9-a1);
		text-shadow: 0 0 0.0625rem var(--grey-9-a1);
		color: var(--text-color);
	}

	#nav {
		transition:
			transform 0.4s ease,
			height 0.28s cubic-bezier(0.4, 0, 0.2, 1),
			background-color 0.28s ease,
			box-shadow 0.28s ease;
	}

	#nav > div,
	#nav a[aria-label="亦林 首页"] {
		transition: height 0.28s cubic-bezier(0.4, 0, 0.2, 1);
	}

	/* ── ④ 导航栏滚动毛玻璃收缩（2026-11-05 第三十一批）───────────────────────
	   滚过 60px：高度 4.5rem → 3.5rem、底色换成带透明度的毛玻璃、加一圈主色微光。
	   多色：玻璃底里叠一层主色 → 偏移色相的极淡渐变，跟 --hue 一起转。

	   🔴 **只写标准属性，不要再补 -webkit-backdrop-filter**：layout-style.css:211 记着这条坑 ——
	   两行都写时 Lightning CSS 按构建目标只留 -webkit- 那条，而 Chromium 里
	   getComputedStyle().backdropFilter 读到 "none" → 玻璃完全没生效（看着"淡但不糊"）。
	   🔴 这里不能动 transform：下面脚本用 transform 做"下滑隐藏"，两者会打架。
	      所以收缩只改 height / 背景 / 阴影。 */
	#nav[data-scrolled] {
		height: 3.5rem;
		background-color: color-mix(in oklch, var(--card-bg) 72%, transparent);
		background-image:
			linear-gradient(
				100deg,
				color-mix(in oklch, var(--primary) 10%, transparent) 0%,
				transparent 45%,
				color-mix(in oklch, oklch(0.72 0.14 calc(var(--hue) + 70)) 12%, transparent) 100%
			),
			var(--nav-bg);
		backdrop-filter: blur(14px) saturate(1.6);
		box-shadow:
			0 1px 0 color-mix(in oklch, var(--primary) 18%, transparent),
			0 8px 24px -14px rgb(0 0 0 / 0.35);
	}

	/* 高度变了，内层那几个 h-18 与 logo 块也得跟着缩，否则内容会被裁。
	   ⚠️ logo 从 h-13(52px) 缩到 2.75rem(44px)，不是缩成 3.5rem —— 写 3.5rem 等于把
	      52px 撑到 56px，反而比原来更高（实测 logoHeight 56 就是这么来的）。 */
	#nav[data-scrolled] > div {
		height: 3.5rem;
	}
	#nav[data-scrolled] a[aria-label="亦林 首页"] {
		height: 2.75rem;
	}
</style>

<script>
	const navbar = document.getElementById("nav")
	let lastScrollY = window.scrollY
	let ticking = false // 节流
	const updateNavbar = () => {
		if (!navbar) return
		const currentScrollY = window.scrollY
		if (currentScrollY > lastScrollY && currentScrollY > 0) {
			navbar.style.transform = "translateY(-100%)"
		} else {
			navbar.style.transform = ""
		}
		lastScrollY = currentScrollY

		// ④ 滚动毛玻璃收缩：只切一个属性，样式全交给 CSS
		if (currentScrollY > 60) navbar.setAttribute("data-scrolled", "")
		else navbar.removeAttribute("data-scrolled")

		ticking = false
	}
	window.addEventListener(
		"scroll",
		() => {
			if (!ticking) {
				window.requestAnimationFrame(updateNavbar)
				ticking = true
			}
		},
		{ passive: true },
	)
	// 首帧也要跑一次：从锚点进页面时可能一上来就滚在半路
	updateNavbar()
</script>
