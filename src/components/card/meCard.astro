---
// 左边栏展示头像、名字、hello以及QQ、微信等内容
import { Icon } from "astro-icon/components"
import ImageWrapper from "@/components/commons/ImageWrapper.astro"

const isDev = import.meta.env.DEV

// 社交入口。照参考站 firefly.cuteleaf.cn 的 me-card：外链一律 target="_blank" + rel="me noopener"
// （带 target 会被 SwupManager 的 capture 监听跳过，不会被软导航接管）
const githubUrl = "https://github.com/ks3356143"
const qq = "314298729"
const wechatQr = "/assets/wechat-qr.webp"
---

<div class="card-base p-3">
	<a aria-label="进入关于页" href="/about/">
		<ImageWrapper src={ isDev ? "assets/touxiangDev.png": "assets/touxiang.jpeg" } loading="eager" />
	</a>
	<div class="px-2">
		<div class="mb-1 text-center text-xl font-bold transition dark:text-neutral-50">犟哟</div>
		<div class="mx-auto mb-2 h-1 w-8 bg-(--primary) transition"></div>
		<div class="mb-2.5 text-center text-neutral-400 transition">Hello, I'm Juyial.</div>
		<div class="mb-1 flex flex-wrap justify-center gap-2">
			<span class="relative inline-flex">
				<button type="button" class="btn-regular me-qq-btn relative h-10 w-10" data-qq={qq} aria-label="复制 QQ 号">
					<Icon name="qq" />
				</button>
				<span class="me-qq-tip" role="status"></span>
			</span>
			<span class="relative inline-flex">
				<button type="button" class="btn-regular me-wechat-btn h-10 w-10" aria-label="显示微信二维码" aria-expanded="false">
					<Icon name="wechat" />
				</button>
				<div class="me-qr-pop">
					<img src={wechatQr} width="750" height="750" alt="微信二维码，扫码添加我为好友" decoding="async" />
				</div>
			</span>
			<a href={githubUrl} target="_blank" rel="me noopener" aria-label="GitHub" class="btn-regular h-10 w-10"><Icon name="github" /></a>
			<a href="/rss.xml" target="_blank" rel="noopener" aria-label="RSS 订阅" class="btn-regular h-10 w-10"><Icon name="rss" /></a>
		</div>
	</div>
</div>

<!-- 本组件在 #swup-container 外面（左栏 + 移动端底部堆各一份），脚本每文档只跑一次，
	 所以用普通监听、不走 onReinit（同 Header 系），但必须逐节点绑定，见 AGENTS 五-29 -->
<script>
	// 站点走裸 IP + 纯 HTTP，非安全上下文里 navigator.clipboard 直接不存在，必须留 execCommand 退路
	async function copyText(text: string): Promise<boolean> {
		try {
			if (navigator.clipboard && window.isSecureContext) {
				await navigator.clipboard.writeText(text)
				return true
			}
		} catch {
			/* 落到下面的退路 */
		}
		try {
			const ta = document.createElement("textarea")
			ta.value = text
			ta.setAttribute("readonly", "")
			ta.style.cssText = "position:fixed;top:-9999px;opacity:0"
			document.body.appendChild(ta)
			ta.select()
			// 纯 HTTP 下这是唯一退路，故意用被废弃的 API（deprecated hint 已登记在 AGENTS 三节）
			const ok = document.execCommand("copy")
			document.body.removeChild(ta)
			return ok
		} catch {
			return false
		}
	}

	document.querySelectorAll<HTMLButtonElement>(".me-qq-btn").forEach(btn => {
		const tip = btn.parentElement?.querySelector<HTMLElement>(".me-qq-tip")
		if (!tip) return
		let timer = 0
		btn.addEventListener("click", async () => {
			const ok = await copyText(btn.dataset.qq || "")
			tip.textContent = ok ? "QQ 号已复制" : `QQ：${btn.dataset.qq}`
			tip.classList.add("is-on")
			clearTimeout(timer)
			timer = window.setTimeout(() => tip.classList.remove("is-on"), 1800)
		})
	})

	document.querySelectorAll<HTMLButtonElement>(".me-wechat-btn").forEach(btn => {
		const pop = btn.parentElement?.querySelector<HTMLElement>(".me-qr-pop")
		if (!pop) return
		// 开合状态只由 aria-expanded 表达，CSS 靠它做过渡，JS 不再碰 hidden/display
		const isOpen = () => btn.getAttribute("aria-expanded") === "true"
		const setOpen = (on: boolean) => btn.setAttribute("aria-expanded", String(on))
		btn.addEventListener("click", e => {
			e.stopPropagation()
			setOpen(!isOpen())
		})
		document.addEventListener("click", e => {
			if (isOpen() && !pop.contains(e.target as Node)) setOpen(false)
		})
		document.addEventListener("keydown", e => {
			if (e.key === "Escape" && isOpen()) {
				setOpen(false)
				btn.focus()
			}
		})
	})
</script>
