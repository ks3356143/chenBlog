---
import { siteConfig } from "@/config/siteConfig"
import fs from "node:fs"
import path from "node:path"

export type PageSEO = {
    title?: string // 文章标题
    description?: string // 文章描述
    url?: string
    image?: {
        src: string
        alt: string
    }
    frontmatter?: Object
}

// og:image 必须是「本站 + 绝对 URL + 文件真实存在于 dist/」，社交爬虫不会解析相对路径。
// 站点级默认值现在只有 siteConfig.siteMeta 一处（原先散在 src/data/site.json，是模板遗留脏数据）。
const ogImage = new URL(siteConfig.siteMeta.ogImage, Astro.site ?? siteConfig.site_url).href

/* 每篇文章独立分享图（2026-10-20）：
   `npm run og` 会由文章标题 + 封面合成 1200×630 的 `public/og/<slug>.jpg`，
   文件名与文章 slug 一一对应。这里按当前 URL 反查，**存在就替换默认图**。
   ⚠️ 用 fs 存在性判断而不是"无条件拼路径"：没跑过脚本 / 新增文章但忘了重跑时，
   拼出来的 URL 会 404，社交爬虫拿不到图会退化成无图卡片 —— 宁可用默认图。
   ⚠️ slug 可能含中文（26 篇 CSS100天 系列），encodeURIComponent 由 new URL() 处理。

   🔴 这里必须用 `Astro.props.url ?? Astro.url`，**不能直接读下面解构出来的 url**：
   解构在函数调用之后才发生，直接读会撞 TDZ（"Cannot access 'url' before initialization"）。 */

function findPostOgImage(pageUrl: unknown): string | null {
    try {
        const u = new URL(String(pageUrl))
        const m = u.pathname.match(/^\/posts\/(.+?)\/?$/)
        if (!m) return null
        const slug = decodeURIComponent(m[1])
        // 防目录穿越：slug 来自 URL，只允许单段
        if (slug.includes("/") || slug.includes("..")) return null
        const abs = path.join(process.cwd(), "public", "og", `${slug}.jpg`)
        if (!fs.existsSync(abs)) return null
        return new URL(`/og/${encodeURIComponent(slug)}.jpg`, Astro.site ?? siteConfig.site_url).href
    } catch {
        return null
    }
}

const postOgImage = findPostOgImage(Astro.props.url ?? Astro.url)

const {
    title = siteConfig.siteMeta.name,
    description = siteConfig.siteMeta.description,
    url = Astro.url,
    image = postOgImage
        ? { src: postOgImage, alt: title }
        : { src: ogImage, alt: siteConfig.siteMeta.ogImageAlt },
    frontmatter, // 传入frontmatter
} = Astro.props

/* JSON-LD 生成：值一律交给 JSON.stringify，不再手工拼引号。
   2026-10-12 实测（逐页 JSON.parse dist 产物）：27 篇 BlogPosting 的这段 script **全部是非法 JSON**
   —— "updated" 那行末尾多一个尾逗号 → 富结果解析器按规范**整块丢弃**，结构化数据等于白写。
   同一处 publish/updated 直接内插 Date 对象，输出 "Wed Oct 07 2026 08:00:00 GMT+0800 (中国标准时间)"，
   不是 schema.org 要求的 ISO 8601。
   属性名也改回规范名（publish→datePublished、updated→dateModified、tag→keywords、
   category→articleSection、excerpt→abstract）：即便 JSON 合法，缺 datePublished 的 BlogPosting
   仍拿不到富结果资格。空值交给 JSON.stringify 自动省略，不留 "":"" 这种噪声。 */
function isoDate(value: unknown): string | undefined {
    if (value instanceof Date) return Number.isNaN(value.getTime()) ? undefined : value.toISOString()
    if (typeof value === "string" && value) {
        const d = new Date(value)
        return Number.isNaN(d.getTime()) ? undefined : d.toISOString()
    }
    return undefined
}

function jsonLDGenerator({ type, post, url }: any) {
    if (type === "post") {
        // 分享图优先用**已解析出来的那一张**（postOgImage 命中《/og/<slug>.jpg》时就是它），
        // 其次文章 frontmatter 手写的 image，最后才是站点默认图。
        // ⚠️ 原先这里只读 post.image —— 而 28 篇的 image 全是空串，
        // 于是 JSON-LD 永远写默认图、与页面上 og:image 不一致（2026-10-20 实测到并修正）。
        const explicit = typeof post.image === "string" && post.image ? post.image : ""
        const imageSrc = postOgImage || explicit || ogImage
        const ld = {
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            mainEntityOfPage: { "@type": "WebPage", "@id": String(url) },
            headline: post.title,
            description: post.description || undefined,
            image: new URL(imageSrc, Astro.site ?? siteConfig.site_url).href,
            keywords: Array.isArray(post.tags) && post.tags.length ? post.tags.join(",") : undefined,
            articleSection: post.category || undefined,
            abstract: post.excerpt || undefined,
            datePublished: isoDate(post.published),
            dateModified: isoDate(post.updated ?? post.published),
        }
        return `<script type="application/ld+json">${JSON.stringify(ld)}</script>`
    }
    const websiteLD = {
        "@context": "https://schema.org/",
        "@type": "WebSite",
        name: siteConfig.siteMeta.name,
        url: import.meta.env.SITE,
    }
    return `<script type="application/ld+json">${JSON.stringify(websiteLD)}</script>`
}

const jsonLD = jsonLDGenerator({
    type: frontmatter ? "post" : "website",
    post: frontmatter,
    url,
})
---

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title={siteConfig.siteMeta.name} href={new URL("rss.xml", Astro.site)} />

<!-- SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:site_name" content={siteConfig.siteMeta.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<!-- og:type：文章页 article、其余 website。2026-10-12 实测全站 43/43 页缺失这一条（社交卡片拿不到类型）。 -->
<meta property="og:type" content={frontmatter ? "article" : "website"} />
<meta property="og:image" content={image?.src} />
<meta property="og:image:url" content={image?.src} />
<meta property="og:image:secure_url" content={image?.src} />
<meta property="og:image:type" content="image/jpeg" />
<!-- 尺寸对应 public/og-image.jpg（站头壁纸裁的 1200×630）。
     26 篇文章 frontmatter 的 image 全为空，所以实际永远走站点默认图；
     将来若给某篇传自定义 image，这里的宽高要改成随 image 走 -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={image?.alt} />

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image?.src} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:domain" content={import.meta.env.SITE} />

<!-- JSON LD -->
<Fragment set:html={jsonLD} />
