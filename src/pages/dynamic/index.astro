---
import { Icon } from "astro-icon/components"
import Layout from "@/layouts/Layout.astro"
import DynamicFeed from "@/components/pages/dynamic/DynamicFeed.svelte"
import DynamicItemTemplate from "@/components/pages/dynamic/DynamicItemTemplate.astro"
import { getCollection } from "astro:content"
import { siteConfig } from "@/config/siteConfig"

if (!siteConfig.pages.dynamic) {
	return Astro.redirect("/404/")
}

// 条数在服务端就能算出，页头不必等客户端 fetch 回来才填
const total = (await getCollection("dynamic")).length
---

<Layout title="动态-亦林">
	<div class="card-base px-8 py-6 mb-4">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<div class="flex items-center gap-3">
				<span class="shrink-0 w-12 h-12 rounded-full bg-(--primary)/10 flex items-center justify-center">
					<Icon name="material-symbols:dynamic-feed-rounded" aria-hidden="true" class="text-2xl text-(--primary)" />
				</span>
				<div>
					<h2 class="text-2xl font-bold text-(--primary) mb-1">动态</h2>
					<p class="text-30 text-sm">随手记下此刻的想法与日常。</p>
				</div>
			</div>
			<div class="flex items-center gap-1.5 text-sm text-30">
				<Icon name="material-symbols:dynamic-feed-rounded" aria-hidden="true" />
				<strong class="text-base text-(--primary)">{total}</strong>
				<span>条</span>
			</div>
		</div>
	</div>

	<DynamicFeed client:load itemsPerPage={10} timezone={siteConfig.timezone} />

	<DynamicItemTemplate />
</Layout>
