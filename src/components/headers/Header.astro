---
import { Icon } from "astro-icon/components"
import ThemeIcon from "@/components/oneSize/ThemeIcon.astro"
import Search from "@/components/uiverse/Search.astro"
import Menu from "@/assets/menu.svg"
import MobileMenu from "@/components/headers/MobileMenu.astro"
---

<nav id="nav" aria-label="主导航" class="backdrop nav-bg fixed top-0 h-18 w-full z-30">
	<div class="mx-auto flex h-18 items-center justify-between overflow-visible! px-4 xl:w-[92vw]">
		<div
			class="relative flex h-full w-full items-center justify-between lg:grid lg:grid-cols-[auto_minmax(0,1fr)_auto]"
		>
			<a href="/" class="btn-plain flex h-13 items-center gap-2 px-5" aria-label="亦林 首页">
				<!-- 双木成林：两棵高低错落的极简小树，描边跟 --primary 走，亮暗主题自动换色 -->
				<svg
					viewBox="0 0 32 32"
					class="h-7 w-7 shrink-0"
					fill="none"
					stroke="var(--primary)"
					stroke-width="2.6"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M10 26V8" />
					<path d="M10 15 5 10" />
					<path d="M10 15 15 10" />
					<path d="M22 26V12" />
					<path d="M22 19 17.5 14.5" />
					<path d="M22 19 26.5 14.5" />
					<path d="M5 26h22" />
				</svg>
				<span class="text-lg font-semibold tracking-wide">亦林</span>
			</a>
			<div class="col-start-2 hidden items-center justify-center space-x-1 lg:flex">
				<a href="/" class="btn-plain h-10 px-4">
					<div class="hidden xl:block"><Icon name="home" /></div>
					<div class="pl-1">主页</div>
				</a>
				<a href="/archive/" class="btn-plain h-10 px-4">
					<div class="hidden xl:block"><Icon name="archive" /></div>
					<div class="pl-1">归档</div>
				</a>
				<a href="/guestbook/" class="btn-plain h-10 px-4">
					<div class="hidden xl:block"><Icon name="chat" /></div>
					<div class="pl-1">留言</div>
				</a>
				<a href="/gallery/" class="btn-plain h-10 px-4">
					<div class="hidden xl:block"><Icon name="xiangce" /></div>
					<div class="pl-1">相册</div>
				</a>
				<a href="/about/" class="btn-plain h-10 px-4">
					<div class="hidden xl:block"><Icon name="about" /></div>
					<div class="pl-1">关于</div>
				</a>
			</div>

			<div class="flex items-center justify-center space-x-1">
				<Search />
				<div class="flex items-center justify-center space-x-1">
					<ThemeIcon />
					<div id="nav-menu-panel" class="lg:hidden">
						<div class="btn-plain cursor-pointer p-2">
							<Menu />
						</div>
					</div>
				</div>
			</div>
			<MobileMenu />
		</div>
	</div>
</nav>

<style>
	.nav-bg {
		background-image: var(--nav-bg);
		box-shadow: 0.1rem 0.1rem 0.2rem var(--grey-9-a1);
		text-shadow: 0 0 0.0625rem var(--grey-9-a1);
		color: var(--text-color);
	}

	#nav {
		transition: transform 0.4s ease;
	}
</style>

<script>
	const navbar = document.getElementById("nav")
	let lastScrollY = window.scrollY
	let ticking = false // 节流
	const updateNavbar = () => {
		if (!navbar) return
		const currentScrollY = window.scrollY
		if (currentScrollY > lastScrollY && currentScrollY > 0) {
			navbar.style.transform = "translateY(-100%)"
		} else {
			navbar.style.transform = ""
		}
		lastScrollY = currentScrollY
		ticking = false
	}
	window.addEventListener(
		"scroll",
		() => {
			if (!ticking) {
				window.requestAnimationFrame(updateNavbar)
				ticking = true
			}
		},
		{ passive: true },
	)
</script>
