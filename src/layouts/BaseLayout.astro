---
import { createHash } from "node:crypto"
import { readFileSync } from "node:fs"
import "@/styles/global.css" // tailwind覆盖所有
import "@/styles/main.css"
import "@/styles/transitions.css"
import "@/styles/layout-style.css"
import "@/styles/singles/abutton.css"
import "@/styles/waves.css"
import "@/styles/singles/mainSingles.css"
import "@/styles/markdown.css"
import "@/styles/toc.css"
// 导入Callouts插件主题
import "@rehype-callouts-theme"
// 导入github卡片样式
import "@/styles/markdown-extend.styl"
// 图片查看器
import FancyboxManager from "@/components/features/FancyboxManager.astro"
// 页面过渡 / 窗口缩放动画管理器
import SwupManager from "@/components/features/SwupManager.astro"
// SEO
import SEO, { type PageSEO } from "@/components/SEO.astro"
import { siteConfig } from "@/config/siteConfig"

interface Props extends PageSEO {
    title: string
}

const { title } = Astro.props

// 首页（含 /2/ 这类分页）横幅用高的一套高度变量，切页时做高矮过渡，见 layout-style.css
const pathname = Astro.url.pathname
const isHome = pathname === "/" || /^\/\d+\/$/.test(pathname)

// reinit.js 是「稳定文件名 + 内容会变」的脚本，而 Nginx 给它的是宝塔默认 js/css 的 max-age=43200（12h）：
// 改了 helper 之后回访用户会带着旧 helper 跑新 HTML（正是六节给 /pagefind/ 设 no-cache 要防的错位）。
// 用内容哈希当查询串，改一次文件就换一次 URL，不动服务器配置也能让改动立刻生效。
// ⚠️ 路径按 process.cwd() 拼，别用 import.meta.url：预渲染阶段这个模块在 dist/.prerender/chunks/ 里，
//    相对它去找 ../../public/ 会指到 dist/public/（实测直接 ENOENT 把构建打挂）。
const reinitVersion = createHash("sha256")
    .update(readFileSync(`${process.cwd()}/public/assets/js/reinit.js`))
    .digest("base64url")
    .slice(0, 10)
---

<!doctype html>
<html lang="zh-Hans-CN" class="bg-(--page-bg)">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <!-- sitemap -->
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />
        <title>{title || siteConfig.siteMeta.name}</title>
        <SEO {...Astro.props} />
        <!-- 「导航后重 init」注册表：必须在 body 之前同步执行——容器内的 is:inline 脚本在解析期就要拿到 window.onReinit -->
        <script is:inline src={`/assets/js/reinit.js?v=${reinitVersion}`}></script>
        <script is:inline>
            const setTheme = () => {
                const theme = (() => {
                    if (typeof localStorage != "undefined" && localStorage.getItem("theme")) {
                        return localStorage.getItem("theme")
                    }
                    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                        return "dark"
                    }
                    return "light"
                })()
                if (theme === "light") {
                    document.documentElement.setAttribute("data-theme", "light")
                } else {
                    document.documentElement.setAttribute("data-theme", "dark")
                }
                window.localStorage.setItem("theme", theme || "light")
            }
            setTheme()

            document.addEventListener("astro:after-swap", setTheme)
        </script>
        <!-- 插槽：katex选择性加载css -->
        <slot name="head" />
    </head>
    <body class:list={{ "is-home": isHome }}>
        <slot />
        <!-- Fancybox图片查看器-管理器 -->
        <FancyboxManager />
        <!-- 页面过渡 / 窗口缩放动画 -->
        <SwupManager />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
