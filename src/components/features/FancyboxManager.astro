---
import "@fancyapps/ui/dist/fancybox/fancybox.css"
import "@/styles/fancybox-custom.css"
// Fancybox 管理器组件
---

<script>
    let Fancybox: any

    // 通用配置提到模块作用域：setup() 的 bind 与下面「查看大图」的 show 都要用（原先是 setup 内的局部量）
    const commonOptions = {
        Thumbs: {
            autoStart: true,
            showOnStart: "yes",
        },
        Toolbar: {
            display: {
                left: ["infobar"],
                middle: ["zoomIn", "zoomOut", "toggle1to1", "rotateCCW", "rotateCW", "flipX", "flipY"],
                right: ["slideshow", "thumbs", "close"],
            },
        },
        animated: true,
        dragToClose: true,
        keyboard: {
            Escape: "close",
            Delete: "close",
            Backspace: "close",
            PageUp: "next",
            PageDown: "prev",
            ArrowUp: "next",
            ArrowDown: "prev",
            ArrowRight: "next",
            ArrowLeft: "prev",
        },
        fitToView: true,
        preload: 3,
        infinite: true,
        Panzoom: {
            maxScale: 3,
            minScale: 1,
        },
        caption: false,
    }

    async function setup() {
        // 两个类名都要：.custom-md 是参考站原文（动态页模板仍在用），.custom-markdown 是本项目
        // Markdown.astro 实际输出的类名——改名时这条绑定曾静默失效，文章图片全都不能点看大图
        const selectors = [
            ".custom-md img, .custom-markdown img, #post-cover img, .moment-images img",
            ".moment-images a[data-fancybox]",
            "[data-fancybox]:not(.moment-images a)",
        ]

        // 检查页面是否存在需要 Fancybox 的元素
        const hasElements = selectors.some((selector) => document.querySelector(selector))

        if (!hasElements) return

        // 动态导入资源
        if (!Fancybox) {
            const mod = await import("@fancyapps/ui")
            Fancybox = mod.Fancybox
        }

        // 绑定图片
        Fancybox.bind(".custom-md img, .custom-markdown img, #post-cover img, .moment-images img", {
            ...commonOptions,
            groupAll: true,
            Carousel: {
                transition: "slide",
                preload: 2,
            },
        })

        // 绑定链接
        Fancybox.bind(".moment-images a[data-fancybox]", {
            ...commonOptions,
            source: (el: any) => el.getAttribute("data-src") || el.getAttribute("href"),
        })

        // 绑定其他
        Fancybox.bind("[data-fancybox]:not(.moment-images a)", commonOptions)
    }

    function cleanupFancybox() {
        if (Fancybox) {
            Fancybox.close()
            Fancybox.unbind(document.body)
        }
    }

    // 初始化
    setup()

    // Swup 生命周期整合
    document.addEventListener("swup:content:replace", setup)
    document.addEventListener("swup:visit:start", cleanupFancybox)

    // 动态页画廊「查看大图」用：条目正文里的图是客户端渲染的，灯箱要按需从别处唤起。
    // 暴露一个全局方法，内部确保 Fancybox 已加载再 show（items = [{src,caption}]，startIndex 定位）。
    // ⚠️ 这是本站唯一"从外部主动开灯箱"的入口，别在别处另起一套 import。
    // caption:true 覆盖 commonOptions 的 false —— 从查看大图进来的要显示图片说明。
    // （画廊缩略图是 <button>、不靠这里的 [data-fancybox] bind，所以也不需要"渲染完补 setup"的事件了。）
    window.__fancyboxOpenImages = async (items, startIndex = 0) => {
        if (!Array.isArray(items) || items.length === 0) return
        if (!Fancybox) {
            const mod = await import("@fancyapps/ui")
            Fancybox = mod.Fancybox
        }
        Fancybox.show(items, { ...commonOptions, caption: true, startIndex })
    }

    // 这里原有 password:decrypted 重绑灯箱的监听：本站无密码门 UI、事件无派发方，2026-09-30 删（见 AGENTS 五-5）
</script>
