---
import type { GetStaticPaths } from "astro"
import Layout from "@/layouts/Layout.astro"
import { siteConfig } from "@/config/siteConfig"
import { getSortedPosts } from "@/utils/content-utils"
import PostPage from "@/components/layout/PostPage.astro"
import Pagination from "@/components/commons/Pagination.astro"

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts()
	// PZ：每页文章数
	const pageSize = siteConfig.perPagePosts
	return paginate(allBlogPosts, { pageSize })
}) satisfies GetStaticPaths

const { page } = Astro.props
// 分页第 2 页起补「第N页」前缀：否则 /2/ /3/ 的 <title> 与首页字节相同
// （全站 43 页只有 41 个不同标题）。命名跟归档 / 分类 / 标签等同一页型组，即 `X-亦林`。
const paginationTitle = page.currentPage > 1 ? `第${page.currentPage}页-亦林` : undefined
---

<Layout title={paginationTitle}>
	<PostPage page={page} />
	<!-- 分页组件 -->
	{page.total > page.size && <Pagination class="mx-auto" page={page} />}
</Layout>
