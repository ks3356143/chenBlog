---
import type { MarkdownHeading } from "astro"
import SiteStatus from "@/components/card/SiteStatus.astro"
import Calender from "@/components/card/Calender.astro"
import DynamicSidebar from "@/components/card/DynamicSidebar.astro"
import SiteInfo from "@/components/card/SiteInfo.astro"
import SiderBarToc from "../card/SiderBarToc.astro"

// 右边栏，文章详情显示TOC，其他时候显示日历

interface Props {
	isPostPage?: boolean
	headings?: MarkdownHeading[]
	class?: string
}

const { isPostPage = false, headings } = Astro.props
const className = Astro.props.class
---

<!-- 非sticky卡片 -->
<div class:list={["mb-4 flex w-full flex-col gap-4", className]}>
	<!-- 站点统计 -->
	<SiteStatus />
	<!-- 最新动态（数据为空或关了动态页时整块不渲染） -->
	<DynamicSidebar />
	<!-- 站点信息（构建期取值，常驻两行 + 可展开的构建信息） -->
	<SiteInfo />
</div>

<!-- sticky卡片 -->
<!-- 日历文章/或TOC -->
{isPostPage ? <SiderBarToc headings={headings}  /> : <Calender />}
