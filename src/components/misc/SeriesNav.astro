---
import { Icon } from "astro-icon/components"
import type { PostForList } from "@/utils/content-utils"
import { getPostUrlBySlug } from "@/utils/url-utils"

interface Props {
	seriesName: string
	posts: PostForList[]
	currentPostId?: string
}

const { seriesName, posts, currentPostId } = Astro.props

// 当前篇在系列里的位置（1-based）。currentPostId 传空或不在系列里时按 0 处理，
// 此时不显示「第 N/M 篇」，但手风琴照常展开（兼容其它调用方）。
const currentIndex = currentPostId ? posts.findIndex((p) => p.id === currentPostId) : -1
const hasPosition = currentIndex >= 0
const positionLabel = hasPosition ? `第 ${currentIndex + 1} / ${posts.length} 篇` : ""

// 系列内的前 / 后篇（按 seriesOrder 排，与文章页底部按发布时间排的「上/下一篇」是两回事）
const prevPost = hasPosition && currentIndex > 0 ? posts[currentIndex - 1] : null
const nextPost = hasPosition && currentIndex < posts.length - 1 ? posts[currentIndex + 1] : null
---

{
	posts.length > 0 && (
		<div class="series-nav my-3 overflow-hidden rounded-xl border border-(--primary)/25" data-pagefind-ignore>
			<button
				type="button"
				aria-expanded="false"
				class="series-nav-toggle group flex w-full cursor-pointer select-none items-center gap-2 rounded-lg bg-(--btn-plain-bg-hover) px-3 py-1.5 text-left"
			>
				<Icon
					name="material-symbols:format-list-bulleted"
					aria-hidden="true"
					class="shrink-0 text-lg text-(--primary)"
				/>
				<span class="font-bold text-base text-black/80 transition group-hover:text-(--primary) dark:text-white/80">
					属于系列：{seriesName}
				</span>
				{
					hasPosition && (
						<span
							class="shrink-0 rounded-sm bg-(--btn-regular-bg) px-1.5 py-0.5 text-xs font-medium tabular-nums text-(--primary)"
							title={`本系列共 ${posts.length} 篇，当前是第 ${currentIndex + 1} 篇`}
						>
							{positionLabel}
						</span>
					)
				}
				<span class="ml-auto shrink-0 rounded-full bg-(--btn-regular-bg) px-2 py-0.5 text-xs text-(--btn-content) transition">
					{posts.length}
				</span>
				<Icon
					name="material-symbols:keyboard-arrow-down-rounded"
					aria-hidden="true"
					class="details-arrow shrink-0 text-[1.25rem] text-(--primary) transition-transform duration-300"
				/>
			</button>

			<div class="series-nav-content max-h-0 overflow-hidden transition-[max-height,opacity] duration-300 ease-in-out">
				<ol class="mt-1 flex flex-col">
					{
						posts.map((post, idx) => {
							const part = `第 ${idx + 1} 篇`
							const isCurrent = !!currentPostId && post.id === currentPostId
							const rowClass = [
								"group flex items-center gap-3 rounded-lg px-3 py-1.5 transition-all",
								!isCurrent && "hover:bg-black/5 active:scale-[0.98] dark:hover:bg-white/5",
								idx < posts.length - 1 && "border-b border-dashed border-(--line-divider)",
							]
							return isCurrent ? (
								<li class:list={rowClass}>
									<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-(--btn-regular-bg) text-sm font-bold text-(--primary) transition">
										{idx + 1}
									</span>
									<span class="min-w-0 flex-1 truncate font-bold text-sm text-black/75 transition group-hover:text-(--primary) dark:text-white/75">
										{post.data.title}
									</span>
									<span
										aria-current="page"
										title={part}
										class="ml-auto shrink-0 rounded-sm bg-(--btn-regular-bg) px-1.5 py-0.5 text-xs text-(--primary)"
									>
										本篇
									</span>
								</li>
							) : (
								<li>
									<a
										href={getPostUrlBySlug(post.id)}
										title={part}
										aria-label={part}
										class:list={rowClass}
									>
										<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-(--btn-regular-bg) text-sm font-bold text-(--primary) transition">
											{idx + 1}
										</span>
										<span class="min-w-0 flex-1 truncate font-bold text-sm text-black/75 transition group-hover:text-(--primary) dark:text-white/75">
											{post.data.title}
										</span>
										<Icon
											name="material-symbols:chevron-right-rounded"
											aria-hidden="true"
											class="shrink-0 text-xl text-black/15 transition group-hover:translate-x-0.5 group-hover:text-(--primary) dark:text-white/15"
										/>
									</a>
								</li>
							)
						})
					}
				</ol>
			</div>

			{
				hasPosition && (prevPost || nextPost) && (
					<div class="series-stepper grid grid-cols-2 border-t border-(--line-divider)">
						{prevPost ? (
							<a
								href={getPostUrlBySlug(prevPost.id)}
								class="group/step flex min-w-0 items-center gap-1.5 px-3 py-2 text-left transition-colors hover:bg-(--btn-plain-bg-hover)"
								title={`系列上一篇：${prevPost.data.title}`}
							>
								<Icon
									name="material-symbols:chevron-left-rounded"
									aria-hidden="true"
									class="shrink-0 text-lg text-(--primary) transition group-hover/step:-translate-x-0.5"
								/>
								<span class="flex min-w-0 flex-col">
									<span class="text-[11px] leading-none text-30">系列上一篇</span>
									<span class="mt-0.5 truncate text-xs font-medium text-black/75 dark:text-white/75">
										{prevPost.data.title}
									</span>
								</span>
							</a>
						) : (
							<span class="flex items-center gap-1.5 px-3 py-2 text-[11px] text-30">
								<Icon name="material-symbols:chevron-left-rounded" aria-hidden="true" class="shrink-0 text-lg opacity-30" />
								已是系列第一篇
							</span>
						)}
						{nextPost ? (
							<a
								href={getPostUrlBySlug(nextPost.id)}
								class="group/step flex min-w-0 items-center justify-end gap-1.5 border-l border-(--line-divider) px-3 py-2 text-right transition-colors hover:bg-(--btn-plain-bg-hover)"
								title={`系列下一篇：${nextPost.data.title}`}
							>
								<span class="flex min-w-0 flex-col items-end">
									<span class="text-[11px] leading-none text-30">系列下一篇</span>
									<span class="mt-0.5 truncate text-xs font-medium text-black/75 dark:text-white/75">
										{nextPost.data.title}
									</span>
								</span>
								<Icon
									name="material-symbols:chevron-right-rounded"
									aria-hidden="true"
									class="shrink-0 text-lg text-(--primary) transition group-hover/step:translate-x-0.5"
								/>
							</a>
						) : (
							<span class="flex items-center justify-end gap-1.5 border-l border-(--line-divider) px-3 py-2 text-[11px] text-30">
								已是系列最后一篇
								<Icon name="material-symbols:chevron-right-rounded" aria-hidden="true" class="shrink-0 text-lg opacity-30" />
							</span>
						)}
					</div>
				)
			}
		</div>
	)
}

<script is:inline>
	function onSeriesNavToggle(e) {
		var btn = e.target && e.target.closest ? e.target.closest(".series-nav-toggle") : null;
		if (!btn) return;
		var box = btn.closest(".series-nav");
		var content = box ? box.querySelector(".series-nav-content") : null;
		if (!content) return;

		var isOpen = btn.getAttribute("aria-expanded") === "true";
		var next = !isOpen;
		btn.setAttribute("aria-expanded", String(next));
		content.setAttribute("data-open", String(next));
		content.style.maxHeight = next ? content.scrollHeight + "px" : "0px";

		if (next) {
			box.classList.add("is-expanded");
		} else {
			// 收起动画走完再恢复圆角（与 max-height 过渡时长一致）
			setTimeout(function () {
				if (box && btn.getAttribute("aria-expanded") !== "true") box.classList.remove("is-expanded");
			}, 300);
		}
	}

	// 事件委托，整个文档只注册一次：本脚本在 #swup-container 内，每次进文章页会被重新插入并重新求值，
	// reinitOnce 取代了原来手写的 window.__seriesNavInit 幂等标志（helper 见 public/assets/js/reinit.js）
	window.reinitOnce("series-nav-toggle", function () {
		document.addEventListener("click", onSeriesNavToggle);
	});
</script>
