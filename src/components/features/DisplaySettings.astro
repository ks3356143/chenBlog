---
import { Icon } from "astro-icon/components"
// 显示设置面板（2026-11-05 新增）。
//
// 结构对照参考站 firefly.cuteleaf.cn 的 DisplaySettingsIntegrated：
//   <div id="display-setting" class="float-panel float-panel-closed absolute ...">
//   tab 栏 = 「外观 / 壁纸 / 特效」，每个分区 = .section-title + 控件，
//   每个 section-title 右侧带一个「重置此项」按钮（参考站是 aria-label="Reset to Default"）。
//
// 🔴 **只做本站真能生效的开关**。参考站还有 壁纸模式(4 种) / 全屏布局 / 壁纸透明度 /
//    背景模糊度 / 卡片透明度 / 樱花特效 / 音乐 / 翻译 —— 本站没有对应实现
//    （没有 fullscreen/overlay 壁纸分支、没有樱花层、没有音乐播放器），
//    装上去就是死开关，点了一点反应都没有。故一律不做，面板里 6 个控件全部有真实效果。
//
// 🔴 **面板必须挂在 Header 里**（不是 FloatingControls）：参考站的 #display-setting
//    就在 #nav 内部（实测 HTML 里 面板位置 87197 落在 <nav> 与 </nav> 之间），
//    而 Header 在 Swup 容器外、永不被替换 → 面板状态（哪个 tab、开着没开）跨软导航保持，
//    不用任何 reinit。开关本身写 localStorage，与参考站键名一致。
//
// ⚠️ 面板一律直角（AGENTS 五-16③：本站 --radius-large 从未定义，全站直角）。
// ⚠️ 本组件的 CSS 必须 is:global：面板里的控件（.float-panel / .section-title /
//    .hue-slider-shell / .custom-scrollbar / .toggle-switch）是跨组件复用的类名，
//    且 PostPage 的 #post-list-container 根本不在本组件里。
---

<!-- 开关按钮：照参考站 #display-settings-switch 的四件套（aria-controls / aria-expanded /
     btn-plain 尺寸与相邻的搜索、主题按钮同档）。⚠️ 它和面板必须包在同一个不带定位的
     wrapper 里：面板是 position:absolute，包一层 relative 会让 right:1rem 变成相对 wrapper
     而不是相对 #nav，位置整体偏一格。 -->
<button
	id="display-settings-switch"
	type="button"
	class="btn-plain cursor-pointer p-2"
	aria-label="显示设置"
	aria-controls="display-setting"
	aria-expanded="false"
	title="显示设置"
>
	<Icon name="mingcute:palette-line" class="text-2xl" aria-hidden="true" />
</button>

<div
	id="display-setting"
	class="float-panel float-panel-closed"
	data-floating-panel=""
	data-floating-panel-trigger="display-settings-switch"
	inert
	aria-hidden="true"
>
	<!-- tab 栏：tab index 与参考站一致（外观 / 壁纸 / 特效） -->
	<div class="dp-tabs">
		<button type="button" class="dp-tab is-active" data-dp-tab="appearance" aria-selected="true">
			<Icon name="material-symbols:palette-outline" aria-hidden="true" />
			<span class="truncate">外观</span>
		</button>
		<button type="button" class="dp-tab" data-dp-tab="wallpaper" aria-selected="false">
			<Icon name="material-symbols:wallpaper" aria-hidden="true" />
			<span class="truncate">壁纸</span>
		</button>
		<button type="button" class="dp-tab" data-dp-tab="effects" aria-selected="false">
			<Icon name="material-symbols:auto-awesome" aria-hidden="true" />
			<span class="truncate">特效</span>
		</button>
	</div>

	<!-- ===== 外观 ===== -->
	<div class="dp-panel is-active" data-dp-panel="appearance">
		<div class="section-title">
			主题色相
			<button type="button" class="dp-reset" data-dp-reset="hue" aria-label="重置主题色相" title="重置">
				<Icon name="material-symbols:restart-alt" aria-hidden="true" />
			</button>
			<div id="hueValue" class="dp-hue-value">175</div>
		</div>
		<div class="hue-slider-shell">
			<input
				id="colorSlider"
				type="range"
				min="0"
				max="360"
				step="5"
				value="175"
				class="slider"
				aria-label="主题色相"
				style="width: 100%"
			/>
		</div>

		<div class="section-title">
			文章布局
			<button type="button" class="dp-reset" data-dp-reset="layout" aria-label="重置文章布局" title="重置">
				<Icon name="material-symbols:restart-alt" aria-hidden="true" />
			</button>
		</div>
		<div class="dp-row">
			<button type="button" class="dp-choice" data-dp-layout="list">
				<Icon name="material-symbols:format-list-bulleted" aria-hidden="true" />
				<span>列表</span>
			</button>
			<button type="button" class="dp-choice" data-dp-layout="grid">
				<Icon name="material-symbols:apps" aria-hidden="true" />
				<span>网格</span>
			</button>
		</div>

		<div class="section-title">
			卡片样式
			<button type="button" class="dp-reset" data-dp-reset="cardBorder" aria-label="重置卡片样式" title="重置">
				<Icon name="material-symbols:restart-alt" aria-hidden="true" />
			</button>
		</div>
		<button type="button" class="dp-switch" data-dp-toggle="cardBorder">
			<span class="text-sm flex-1">卡片边框和阴影</span>
			<span class="toggle-switch" aria-hidden="true"><span></span></span>
		</button>
	</div>

	<!-- ===== 壁纸 ===== -->
	<div class="dp-panel" data-dp-panel="wallpaper">
		<div class="section-title">
			横幅设置
			<button type="button" class="dp-reset" data-dp-reset="bannerTitle" aria-label="重置横幅设置" title="重置">
				<Icon name="material-symbols:restart-alt" aria-hidden="true" />
			</button>
		</div>
		<button type="button" class="dp-switch" data-dp-toggle="bannerTitle">
			<span class="text-sm flex-1">首页壁纸标题</span>
			<span class="toggle-switch" aria-hidden="true"><span></span></span>
		</button>
		<p class="dp-hint">关闭后首页横幅只留壁纸图与波浪，不显示标题与副标题。</p>
	</div>

	<!-- ===== 特效 ===== -->
	<div class="dp-panel" data-dp-panel="effects">
		<div class="section-title">
			特效开关
			<button type="button" class="dp-reset" data-dp-reset="fx" aria-label="重置特效开关" title="重置">
				<Icon name="material-symbols:restart-alt" aria-hidden="true" />
			</button>
		</div>
		<button type="button" class="dp-switch" data-dp-toggle="waves">
			<span class="text-sm flex-1">水波纹动画</span>
			<span class="toggle-switch" aria-hidden="true"><span></span></span>
		</button>
		<button type="button" class="dp-switch" data-dp-toggle="gradient">
			<span class="text-sm flex-1">渐变过渡</span>
			<span class="toggle-switch" aria-hidden="true"><span></span></span>
		</button>
		<p class="dp-hint">
			水波纹开时渐变过渡自动让位（参考站同款：两者同时开会叠出一条脏边）。
		</p>
	</div>
</div>

<script is:inline>
	// 首帧前套用已保存的所有设置。必须在这里（而不是组件脚本）跑：
	// 面板是 is:inline 且位于 head 之后，越早越好，否则主题色相会「先绿后紫」闪一下。
	;(function applyDisplaySettingsEarly() {
		var d = document.documentElement
		function read(k) {
			try {
				return localStorage.getItem(k)
			} catch (e) {
				return null
			}
		}
		// 主题色相：写到 :root 的行内 --hue，global.css 里那一族 oklch 全部跟着转
		var hue = read("hue")
		if (hue !== null && /^\d+$/.test(hue)) d.style.setProperty("--hue", hue)
		// 下面四个是布尔开关 → 用 class 驱动（写在 global.css，跨页生效）
		if (read("wavesEnabled") === "false") d.setAttribute("data-waves-enabled", "false")
		if (read("gradientEnabled") === "false") d.setAttribute("data-gradient-enabled", "false")
		if (read("bannerTitleEnabled") === "false") d.setAttribute("data-banner-title-enabled", "false")
		// ⚠️ 极性与参考站相反：参考站默认**没有**卡片边框，靠 .enable-card-border 加上；
		// 本站 .card-base 本来就带边框和阴影 → 默认即「有」，所以只在**关闭**时挂类。
		if (read("cardBorderEnabled") === "false") d.classList.add("disable-card-border")
	})()
</script>

<script>
	import { displaySettings, displaySettingsKeys as KEYS } from "@/config/displaySettings"

	type Layout = "list" | "grid"

	const root = document.documentElement

	// ---------- 存储 ----------
	const read = (key: string, fallback: string): string => {
		try {
			return localStorage.getItem(key) ?? fallback
		} catch {
			return fallback
		}
	}
	const write = (key: string, value: string) => {
		try {
			localStorage.setItem(key, value)
		} catch {
			/* 隐私模式下写不进去，忽略即可 */
		}
	}

	// ---------- 主题色相 ----------
	const hueValue = document.getElementById("hueValue") as HTMLDivElement | null
	const colorSlider = document.getElementById("colorSlider") as HTMLInputElement | null

	const applyHue = (hue: number) => {
		root.style.setProperty("--hue", String(hue))
		if (hueValue) hueValue.textContent = String(hue)
		if (colorSlider) colorSlider.value = String(hue)
	}

	const savedHue = read(KEYS.hue, "")
	applyHue(savedHue && /^\d+$/.test(savedHue) ? parseInt(savedHue, 10) : displaySettings.hue)

	colorSlider?.addEventListener("input", () => {
		const hue = parseInt(colorSlider.value, 10)
		applyHue(hue)
		write(KEYS.hue, String(hue))
		syncDirty()
	})

	// ---------- 文章布局 ----------
	const listContainer = () => document.getElementById("post-list-container")

	// 与 PostPage 里那段「首帧应用」用同一套类名；这里多一层淡出（参考站的
	// .layout-switching 过渡：先加类 → 200ms 后换布局 → 下一帧摘类）
	const applyLayoutToDom = (layout: Layout) => {
		const c = listContainer()
		if (!c) return
		c.classList.remove("list-mode", "grid-mode", "post-grid-auto", "flex", "flex-col", "gap-4", "md:gap-4")
		if (layout === "grid") {
			c.classList.add("grid-mode", "post-grid-auto")
		} else {
			c.classList.add("list-mode", "flex", "flex-col", "gap-4", "md:gap-4")
		}
	}

	const currentLayout = (): Layout => {
		const c = listContainer()
		if (!c) return read(KEYS.postListLayout, displaySettings.postListLayout.default) as Layout
		if (c.classList.contains("grid-mode")) return "grid"
		if (c.classList.contains("list-mode")) return "list"
		return read(KEYS.postListLayout, displaySettings.postListLayout.default) as Layout
	}

	/** 外部（面板按钮）入口：保存 + 切换。文章页没有容器 → 只存不切，回首页生效。 */
	const setPostListLayout = (layout: Layout) => {
		write(KEYS.postListLayout, layout)
		const c = listContainer()
		if (!c) {
			syncDirty()
			return
		}
		if (currentLayout() === layout) {
			// 已经是目标布局，只补一次类名（防止首帧脚本没跑到）
			applyLayoutToDom(layout)
			syncDirty()
			return
		}
		c.classList.add("layout-switching")
		window.setTimeout(() => {
			applyLayoutToDom(layout)
			requestAnimationFrame(() => {
				const el = listContainer()
				if (el) el.classList.remove("layout-switching")
			})
			syncDirty()
		}, 200)
	}
	;(window as unknown as { setPostListLayout: typeof setPostListLayout }).setPostListLayout = setPostListLayout

	document.querySelectorAll<HTMLButtonElement>("[data-dp-layout]").forEach(btn => {
		btn.addEventListener("click", () => setPostListLayout(btn.dataset.dpLayout as Layout))
	})

	// ---------- 布尔开关 ----------
	type BoolKey = "waves" | "gradient" | "bannerTitle" | "cardBorder"

	const applyBool = (key: BoolKey, on: boolean) => {
		if (key === "waves") {
			if (on) root.removeAttribute("data-waves-enabled")
			else root.setAttribute("data-waves-enabled", "false")
			if (!on) write(KEYS.wavesEnabled, "false")
		} else if (key === "gradient") {
			if (on) root.removeAttribute("data-gradient-enabled")
			else root.setAttribute("data-gradient-enabled", "false")
			if (!on) write(KEYS.gradientEnabled, "false")
		} else if (key === "bannerTitle") {
			if (on) root.removeAttribute("data-banner-title-enabled")
			else root.setAttribute("data-banner-title-enabled", "false")
			if (!on) write(KEYS.bannerTitleEnabled, "false")
		} else {
			root.classList.toggle("disable-card-border", !on)
			if (!on) write(KEYS.cardBorderEnabled, "false")
		}
	}

	const boolState = (key: BoolKey): boolean => {
		if (key === "waves") return read(KEYS.wavesEnabled, "true") !== "false"
		if (key === "gradient") return read(KEYS.gradientEnabled, "true") !== "false"
		if (key === "bannerTitle") return read(KEYS.bannerTitleEnabled, "true") !== "false"
		return read(KEYS.cardBorderEnabled, "true") !== "false"
	}

	document.querySelectorAll<HTMLButtonElement>("[data-dp-toggle]").forEach(btn => {
		btn.addEventListener("click", () => {
			const key = btn.dataset.dpToggle as BoolKey
			const next = !boolState(key)
			applyBool(key, next)
			// 打开时把存储值删掉，回到「跟随默认」，与参考站的 null 语义一致
			if (next) {
				try {
					localStorage.removeItem(
						key === "waves"
							? KEYS.wavesEnabled
							: key === "gradient"
								? KEYS.gradientEnabled
								: key === "bannerTitle"
									? KEYS.bannerTitleEnabled
									: KEYS.cardBorderEnabled
					)
				} catch {
					/* ignore */
				}
			}
			syncSwitchStates()
			syncDirty()
		})
	})

	// ---------- 重置（每个 section 右侧那枚按钮） ----------
	const resets: Record<string, () => void> = {
		hue: () => {
			applyHue(displaySettings.hue)
			try {
				localStorage.removeItem(KEYS.hue)
			} catch {
				/* ignore */
			}
		},
		layout: () => {
			try {
				localStorage.removeItem(KEYS.postListLayout)
			} catch {
				/* ignore */
			}
			const def = listContainer()?.getAttribute("data-default-layout") || displaySettings.postListLayout.default
			setPostListLayout(def as Layout)
		},
		cardBorder: () => {
			applyBool("cardBorder", true)
			try {
				localStorage.removeItem(KEYS.cardBorderEnabled)
			} catch {
				/* ignore */
			}
			syncSwitchStates()
		},
		bannerTitle: () => {
			applyBool("bannerTitle", true)
			try {
				localStorage.removeItem(KEYS.bannerTitleEnabled)
			} catch {
				/* ignore */
			}
			syncSwitchStates()
		},
		fx: () => {
			applyBool("waves", true)
			applyBool("gradient", true)
			try {
				localStorage.removeItem(KEYS.wavesEnabled)
				localStorage.removeItem(KEYS.gradientEnabled)
			} catch {
				/* ignore */
			}
			syncSwitchStates()
		},
	}
	document.querySelectorAll<HTMLButtonElement>("[data-dp-reset]").forEach(btn => {
		btn.addEventListener("click", () => {
			resets[btn.dataset.dpReset || ""]?.()
			syncDirty()
		})
	})

	// ---------- 面板显示状态同步 ----------
	// 参考站用的是 data-floating-panel + inert + aria-hidden + aria-expanded 四件套
	// （AGENTS 五-16 末条：Header 在容器外，浮层跳页后不自动清，所以状态要显式收回来）
	const panel = document.getElementById("display-setting")
	const trigger = document.getElementById("display-settings-switch")

	const setPanelOpen = (open: boolean) => {
		if (!panel) return
		panel.classList.toggle("float-panel-closed", !open)
		panel.toggleAttribute("inert", !open)
		panel.setAttribute("aria-hidden", open ? "false" : "true")
		trigger?.setAttribute("aria-expanded", open ? "true" : "false")
		document.body.classList.toggle("display-panel-open", open)
	}

	trigger?.addEventListener("click", e => {
		e.stopPropagation()
		setPanelOpen(trigger.getAttribute("aria-expanded") !== "true")
	})
	document.addEventListener("click", e => {
		if (!panel || panel.classList.contains("float-panel-closed")) return
		const t = e.target as Element
		if (panel.contains(t) || trigger?.contains(t)) return
		setPanelOpen(false)
	})
	document.addEventListener("keydown", e => {
		if (e.key === "Escape" && panel && !panel.classList.contains("float-panel-closed")) setPanelOpen(false)
	})

	// tab 切换
	document.querySelectorAll<HTMLButtonElement>("[data-dp-tab]").forEach(btn => {
		btn.addEventListener("click", () => {
			const name = btn.dataset.dpTab
			document.querySelectorAll<HTMLButtonElement>("[data-dp-tab]").forEach(b => {
				const on = b.dataset.dpTab === name
				b.classList.toggle("is-active", on)
				b.setAttribute("aria-selected", on ? "true" : "false")
			})
			document.querySelectorAll<HTMLDivElement>("[data-dp-panel]").forEach(p => {
				p.classList.toggle("is-active", p.dataset.dpPanel === name)
			})
		})
	})

	// ---------- 状态回显 ----------
	function syncSwitchStates() {
		document.querySelectorAll<HTMLButtonElement>("[data-dp-toggle]").forEach(btn => {
			const on = boolState(btn.dataset.dpToggle as BoolKey)
			btn.classList.toggle("is-on", on)
			btn.setAttribute("aria-pressed", on ? "true" : "false")
		})
	}

	// 有改动过的项 → 它的重置按钮才亮（参考站同款：默认 opacity-0 pointer-events-none disabled）
	function syncDirty() {
		const dirty: Record<string, boolean> = {
			hue: read(KEYS.hue, "") !== "",
			layout: read(KEYS.postListLayout, "") !== "",
			cardBorder: read(KEYS.cardBorderEnabled, "") !== "",
			bannerTitle: read(KEYS.bannerTitleEnabled, "") !== "",
			fx: read(KEYS.wavesEnabled, "") !== "" || read(KEYS.gradientEnabled, "") !== "",
		}
		document.querySelectorAll<HTMLButtonElement>("[data-dp-reset]").forEach(btn => {
			const on = !!dirty[btn.dataset.dpReset || ""]
			btn.classList.toggle("is-available", on)
			btn.toggleAttribute("disabled", !on)
		})
		const layout = currentLayout()
		document.querySelectorAll<HTMLButtonElement>("[data-dp-layout]").forEach(b => {
			b.classList.toggle("is-active", b.dataset.dpLayout === layout)
		})
	}

	syncSwitchStates()
	syncDirty()

	// 软导航后：新容器带着服务端默认类名 → 重新套一次用户选择（不写存储，只重放）
	window.onReinit(
		"display-settings-layout",
		() => {
			const c = listContainer()
			if (!c) return
			const saved = read(KEYS.postListLayout, "")
			if (saved === "list" || saved === "grid") applyLayoutToDom(saved)
			syncDirty()
		},
		{ delay: 60 }
	)
</script>

<style is:global>
	/* ===== 面板外壳（照参考站 .float-panel，但直角） ===== */
	.float-panel {
		position: absolute;
		top: calc(var(--spacing, 0.25rem) * 21);
		right: 1rem;
		width: 20rem;
		/* ⚠️ 面板的 offsetParent 不是 #nav，而是 #nav 内部那层 `relative ... justify-between`
		   （实测 320px 视口下它只有 288px 宽），所以百分比要按它算、不能按 100vw 算：
		   写 max-width: calc(100vw - 2rem) 时 320px 下算出 288px = offsetParent 整宽，
		   再叠 right:1rem 就顶到视口左侧外面（实测 left:-4）。改成 100%（= 288px）后
		   上限是 272px，right:1rem 一定还留得下。 */
		max-width: calc(100% - 1rem);
		max-height: 80vh;
		overflow-y: auto;
		padding: 0 0.75rem 0.75rem;
		border: 1px solid var(--line-divider);
		background-color: var(--card-bg);
		box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
		transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
		z-index: 40;
	}

	/* 关闭态：参考站是 translateY(-0.25rem) + opacity 0 + pointer-events none。
	   ⚠️ 用 opacity/visibility/transform 而不是 display:none —— 后者没有可插值属性，
	   过渡根本不跑（AGENTS 五-41）。 */
	.float-panel-closed {
		opacity: 0;
		visibility: hidden;
		transform: translateY(-0.25rem);
		pointer-events: none;
	}
	.float-panel-closed * {
		pointer-events: none;
	}

	/* ===== tab 栏 ===== */
	.dp-tabs {
		display: flex;
		gap: 0.25rem;
		border-bottom: 1px solid var(--line-divider);
		padding-top: 0.75rem;
		padding-bottom: 0.25rem;
		margin-bottom: 0.75rem;
	}
	.dp-tab {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		padding: 0.5rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--grey-5);
		transition: background-color 0.15s, color 0.15s;
		cursor: pointer;
	}
	.dp-tab svg {
		font-size: 1.5rem;
	}
	.dp-tab:hover {
		background-color: var(--btn-plain-bg-hover);
		color: var(--grey-7);
	}
