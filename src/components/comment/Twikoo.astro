---
import { commentConfig } from "@/config/commentConfig"
import { url } from "@/utils/url-utils"

const config = {
    ...commentConfig.twikoo,
    el: "#tcomment",
}
---

<div id="tcomment"></div>
<!-- 下载放入public里面 -->
<script is:inline src={url("/assets/js/twikoo.nocss.js")}></script>
<link rel="stylesheet" href={url("/assets/css/twikoo.css")} />
<link rel="stylesheet" href={url("/assets/css/twikoo-custom.css")} />
<script is:inline define:vars={{ config }}>
    // 获取当前页面路径
    function getCurrentPath() {
        const pathname = window.location.pathname
        return pathname.endsWith("/") && pathname.length > 1 ? pathname.slice(0, -1) : pathname
    }

    // 动态创建配置对象
    function createTwikooConfig() {
        return {
            ...config,
            path: getCurrentPath(),
            el: "#tcomment",
        }
    }

    // 初始化 Twikoo
    function initTwikoo() {
        if (typeof twikoo !== "undefined") {
            const commentEl = document.getElementById("tcomment")
            if (commentEl) {
                commentEl.innerHTML = ""

                const dynamicConfig = createTwikooConfig()

                twikoo
                    .init(dynamicConfig)
                    .catch((error) => {
                        console.error("[Twikoo] 初始化失败:", error)
                    })
            }
        } else {
            // 如果 Twikoo 未加载，稍后重试
            setTimeout(initTwikoo, 500)
        }
    }

    // 首屏初始化：本脚本在容器内，软导航会重新求值，直接挂 DOMContentLoaded 监听的话
    // 每进一篇就累加一条永不触发的死监听，所以用 reinitOnce 保证一个文档里只挂一次
    window.reinitOnce("twikoo-first-load", () => {
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initTwikoo, { once: true })
        } else {
            initTwikoo()
        }
    })

    // 之后每次导航后 200ms 重新 init。幂等由 helper 负责（它的监听在 head 里只绑一次），
    // 所以这里不再需要 __twikooSwupInit 标志；原先的 swup:enable 回退分支也一并删掉——
    // 那条只是为了「本脚本比 swup 先跑」而存在，helper 与 swup 的加载时机无关。
    // initTwikoo 每次调用都重新 getElementById 与取当前 path，换页后的新闭包是安全的（AGENTS 十-12）。
    window.onReinit("twikoo", initTwikoo, { delay: 200, immediate: false })
</script>
