---
import Layout from "@/layouts/Layout.astro"
import { getCategoryList, getSortedPostsList } from "@/utils/content-utils"
import { Icon } from "astro-icon/components"

const categories = (await getCategoryList()).filter(category => category.name.trim() !== "")
const totalPosts = (await getSortedPostsList()).length
---

<Layout title="分类-Yilin">
	<div class="card-base px-8 py-6 mb-4">
		<div class="text-2xl font-bold text-(--primary) mb-2">分类</div>
		<p class="text-30 text-sm">全部分类 · {totalPosts} 篇文章</p>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
		{
			categories.map((category, index) => (
				<a
					href={category.url}
					class="card-base p-6 flex items-center gap-4 group onload-animation"
					style={`animation-delay: calc(var(--content-delay) + ${index * 50}ms)`}
				>
					<div class="shrink-0 w-14 h-14 rounded-full bg-(--primary)/10 group-hover:bg-(--primary)/20 flex items-center justify-center transition-colors">
						<Icon name="material-symbols:folder-open" class="text-3xl text-(--primary)" />
					</div>
					<div class="flex-1 min-w-0">
						<h2
							class="text-lg font-bold text-90 truncate group-hover:text-(--primary) transition-colors"
							title={category.name}
						>
							{category.name}
						</h2>
						<p class="text-sm text-30 mt-1 group-hover:text-(--primary)/60 transition-colors">
							{category.count} 篇文章
						</p>
					</div>
					<div class="shrink-0">
						<Icon
							name="material-symbols:chevron-right-rounded"
							class="text-2xl text-30 group-hover:text-(--primary) transition-colors"
						/>
					</div>
				</a>
			))
		}
	</div>
</Layout>
