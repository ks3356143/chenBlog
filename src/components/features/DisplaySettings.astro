	.dp-tab::after {
		content: "";
		position: absolute;
		left: 50%;
		bottom: 0.125rem;
		height: 2px;
		width: 0;
		background: var(--primary);
		transform: translateX(-50%);
		transition:
			width 0.24s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.2s ease;
		opacity: 0;
	}
	.dp-tab.is-active::after {
		width: 1.25rem;
		opacity: 1;
	}

